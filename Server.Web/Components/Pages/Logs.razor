@page "/logs/{Kind}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject LogBufferService LogBuffer

<PageTitle>@Title · Zircon</PageTitle>

<div class="page-heading compact">
    <div>
        <span class="eyebrow">运行 / @KindText</span>
        <h1>@Title</h1>
        <p>最近的服务器输出，自动滚动缓冲但不会影响持久日志。</p>
    </div>
    <RadzenButton Text="清空显示" Icon="delete_sweep" ButtonStyle="ButtonStyle.Light" Click="Clear" />
</div>

@* 过滤条（2026-11-22）：日志太多不好找，按「关键字 / 排除词 / 级别 / 假人」四维过滤。
   空格分隔多个词 = 同时包含（AND）；排除词命中任意一个就丢弃。 *@
<div class="control-cluster log-filter">
    <input placeholder="包含关键字（空格分隔=同时包含）" value="@_include" @oninput="e => _include = e.Value?.ToString() ?? string.Empty" />
    <input placeholder="排除关键字" value="@_exclude" @oninput="e => _exclude = e.Value?.ToString() ?? string.Empty" />
    <select value="@_level" @onchange="e => _level = e.Value?.ToString() ?? string.Empty">
        <option value="">全部级别</option>
        <option value="DEBUG">DEBUG</option>
        <option value="INFO">INFO</option>
        <option value="WARN">WARN</option>
        <option value="ERROR">ERROR</option>
    </select>
    <input placeholder="假人编号（如 65）" value="@_bot" @oninput="e => _bot = e.Value?.ToString() ?? string.Empty" style="max-width:140px;" />
    <select value="@_limit.ToString()" @onchange="e => SetLimit(e.Value?.ToString())">
        <option value="200">显示 200 条</option>
        <option value="500">显示 500 条</option>
        <option value="1000">显示 1000 条</option>
        <option value="0">显示全部</option>
    </select>
    <RadzenButton Text="重置" Icon="filter_alt_off" ButtonStyle="ButtonStyle.Light" Click="ResetFilter" />
    <span class="log-filter-count">@Filtered.Count / @Entries.Count 条</span>
</div>

<div class="log-console">
    @if (Filtered.Count == 0)
    {
        <div class="log-empty">@(Entries.Count == 0 ? "等待新的日志事件…" : "没有匹配当前过滤条件的日志")</div>
    }
    @foreach (string line in Filtered)
    {
        <div class="log-line"><span>›</span><code>@line</code></div>
    }
</div>

@code {
    [Parameter] public string Kind { get; set; } = "system";

    private readonly CancellationTokenSource _cts = new();

    private string _include = string.Empty;
    private string _exclude = string.Empty;
    private string _level = string.Empty;
    private string _bot = string.Empty;
    private int _limit = 200;

    private IReadOnlyList<string> Entries => Kind == "chat" ? LogBuffer.GetChatLogs() : LogBuffer.GetSystemLogs();
    private string Title => Kind == "chat" ? "聊天日志" : "系统日志";
    private string KindText => Kind == "chat" ? "聊天" : "系统";

    /// <summary>
    /// 过滤后的日志（2026-11-22）。
    /// <para>
    /// 只取**最后 N 条**：日志页每秒重渲染，2000 条全量渲染会明显卡顿；
    /// 过滤是为了「找到需要的」，不是「翻历史」，所以截尾更实用。
    /// </para>
    /// </summary>
    private List<string> Filtered
    {
        get
        {
            string[] include = SplitTerms(_include);
            string[] exclude = SplitTerms(_exclude);
            string level = _level?.Trim() ?? string.Empty;
            string bot = NormalizeBot(_bot);

            List<string> result = new List<string>();

            foreach (string line in Entries)
            {
                if (line == null) continue;

                if (level.Length > 0 && line.IndexOf("[" + level, StringComparison.OrdinalIgnoreCase) < 0) continue;

                if (bot.Length > 0 && line.IndexOf(bot, StringComparison.OrdinalIgnoreCase) < 0) continue;

                bool matched = true;

                foreach (string term in include)
                {
                    if (line.IndexOf(term, StringComparison.OrdinalIgnoreCase) < 0)
                    {
                        matched = false;
                        break;
                    }
                }

                if (!matched) continue;

                foreach (string term in exclude)
                {
                    if (line.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                    {
                        matched = false;
                        break;
                    }
                }

                if (matched) result.Add(line);
            }

            if (_limit > 0 && result.Count > _limit)
                result = result.GetRange(result.Count - _limit, _limit);

            return result;
        }
    }

    protected override void OnInitialized() => _ = RefreshLoop();

    private async Task RefreshLoop()
    {
        try
        {
            using PeriodicTimer timer = new(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(_cts.Token)) await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private void Clear()
    {
        if (Kind == "chat") LogBuffer.ClearChat(); else LogBuffer.ClearSystem();
    }

    private void ResetFilter()
    {
        _include = string.Empty;
        _exclude = string.Empty;
        _level = string.Empty;
        _bot = string.Empty;
        _limit = 200;
    }

    private void SetLimit(string? value) => _limit = int.TryParse(value, out int parsed) ? parsed : 200;

    private static string[] SplitTerms(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return Array.Empty<string>();

        return text.Split(new[] { ' ', '\t', ',', '，' }, StringSplitOptions.RemoveEmptyEntries);
    }

    /// <summary>允许输入「65」或「BOT#65」，统一成 <c>BOT#65</c> 去匹配。</summary>
    private static string NormalizeBot(string text)
    {
        string value = text?.Trim() ?? string.Empty;

        if (value.Length == 0) return string.Empty;

        if (value.StartsWith("BOT#", StringComparison.OrdinalIgnoreCase)) return value;

        return int.TryParse(value, out int seq) ? "BOT#" + seq : value;
    }

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
