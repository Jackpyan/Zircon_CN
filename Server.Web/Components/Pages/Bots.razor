@page "/bots"
@attribute [Authorize]
@implements IDisposable
@using Server.Bots
@using Server.Envir
@using Server.Web.Services
@using Library
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject BotAdminService Admin
@inject IGameServerController GameServer
@inject ServerMetricsService Metrics
@inject LogBufferService Logs
@inject ConfigurationService ConfigurationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>AI 假人 · Zircon</PageTitle>

<div class="page-heading compact">
    <div>
        <span class="eyebrow">运营 / 人气</span>
        <h1>假人管理</h1>
        <p>
            一律 <strong>0 级新号起号</strong>，用伪连接复用真人的登录 / 进图 / 走路 / 打怪 / 买卖全链路。
            在线数量按水位自动调节：<strong>真人多了就撤、少了就补</strong>。
        </p>
    </div>

    <div class="head-meta">
        <span class="page-status @ServerStateClass()"><i></i>@ServerStateText()</span>
        <span>在线 <b>@Overview.Online</b> / @Overview.Sessions · 更新 <b>@SnapshotAtText()</b></span>

        <AuthorizeView Policy="@AdminPermissions.PolicyOperate">
            <RadzenButton Text="@(Overview.Enabled ? "停用假人" : "启用假人")"
                          Icon="@(Overview.Enabled ? "pause_circle" : "play_circle")"
                          ButtonStyle="@(Overview.Enabled ? ButtonStyle.Warning : ButtonStyle.Success)"
                          Click="ToggleEnabled"
                          Disabled="@(GameServer.State != GameServerState.Running)" />
        </AuthorizeView>
    </div>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_messageOk ? "success" : "danger")" style="margin-bottom:12px;">@_message</div>
}

@if (!Overview.Enabled)
{
    <div class="alert warning" style="margin-bottom:12px;">
        假人调度当前<strong>已停用</strong>。点右上角「启用假人」后，调度器会在下一轮按水位开始拉人。
        参数在「配置 → Bots」，改完即时生效，不用重启。
    </div>
}

<div class="bot-tabs">
    <button class="@(_tab == TabOverview ? "active" : "")" @onclick="@(() => _tab = TabOverview)">实时总览</button>
    <button class="@(_tab == TabManage ? "active" : "")" @onclick="@(() => _tab = TabManage)">上线管理<small>@Overview.Online/@Overview.Sessions</small></button>
    <button class="@(_tab == TabFiles ? "active" : "")" @onclick="@(() => _tab = TabFiles)">配置文件<small>@_nameCount/@_chatCount</small></button>
    <button class="@(_tab == TabLogs ? "active" : "")" @onclick="@(() => _tab = TabLogs)">运行日志</button>
</div>

@* ============================ 实时总览 ============================ *@
@if (_tab == TabOverview)
{
    <div class="metric-grid">
        <div class="metric-card green">
            <span>在线假人</span>
            <strong>@Overview.Online<small style="font-size:16px;color:#6d7d82;"> / @Overview.Sessions</small></strong>
            <small class="metric-note">
                水位目标 @Overview.Target · 真人 @Overview.RealPlayers
                @if (Overview.NightActive)
                {
                    <b style="color:var(--amber,#b8860b);"> · 夜间缩水 @Config.BotNightScalePercent%</b>
                }
                @if (Perf.BreakerOpen)
                {
                    <b style="color:var(--red);"> · 熔断压住</b>
                }
            </small>
        </div>
        <div class="metric-card cyan">
            <span>平均等级</span>
            <strong>@Overview.AverageLevel.ToString("0.#")</strong>
            <small class="metric-note">只算在线</small>
        </div>
        <div class="metric-card amber">
            <span>总击杀</span>
            <strong>@Overview.TotalKills</strong>
            <small class="metric-note">复活 @Overview.TotalDeaths</small>
        </div>
        <div class="metric-card">
            <span>存活率</span>
            <strong>@Overview.SurvivalRateText</strong>
            <small class="metric-note">击杀 /（击杀 + 复活）</small>
        </div>
        <div class="metric-card amber">
            <span>总金币</span>
            <strong style="font-size:clamp(20px,2vw,30px);">@Overview.TotalGold.ToString("N0")</strong>
            <small class="metric-note">本次赚 @Overview.GoldEarned.ToString("N0") · @Overview.GoldPerHour.ToString("N0")/时</small>
        </div>
        <div class="metric-card @(Overview.Overweight > 0 ? "red" : "")">
            <span>超重 / 临界</span>
            <strong>@Overview.Overweight / @Overview.NearOverweight</strong>
            <small class="metric-note">负重 ≥100% / 85%</small>
        </div>
    </div>

    @* ===================== 假人性能（P4-5） ===================== *@
    @* 用 config-grid 而不是 metric-grid：这里要的是「一眼扫到有没有异常」，
       8 个数字排成 3 列紧凑列表比 8 张 140px 的大卡片更省屏，
       下面那张实时表也能留在首屏内。 *@
    <h2 style="margin:4px 0 2px;font-size:16px;">
        假人性能
        <small style="font-size:11px;font-weight:400;opacity:.6;">P4-5 · 每秒采样一次，页面每 2 秒刷新</small>
    </h2>
    <div class="config-grid" style="padding:0 0 12px;">
        <div class="config-field">
            <span>假人段开销 <em>熔断判据</em></span>
            <strong style="@(Perf.BotSharePercent >= Perf.BreakerSharePercent ? "color:var(--red);" : "")">
                @Perf.BotSharePercent.ToString("0.#")%
                <small style="font-weight:400;opacity:.6;">· @Perf.BotMsPerSecond.ToString("0") ms/秒</small>
            </strong>
            <span class="field-note">占主循环 · 阈值 @Perf.BreakerSharePercent% · 单帧 @Perf.BotFrameMs.ToString("0.00") ms（峰值 @Perf.BotFrameMaxMs.ToString("0.0")）</span>
        </div>
        <div class="config-field">
            <span>整帧耗时 <em>主循环</em></span>
            <strong>
                @Perf.LoopFrameMs.ToString("0.00") ms
                <small style="font-weight:400;opacity:.6;">· 峰值 @Perf.LoopFrameMaxMs.ToString("0.0")</small>
            </strong>
            <span class="field-note">@Perf.FramesPerSecond 帧/秒</span>
        </div>
        <div class="config-field">
            <span>存库 / 连接 <em>Save / Con</em></span>
            <strong>@Perf.SaveDelayMs ms / @Perf.ConnectionDelayMs ms</strong>
            <span class="field-note">整帧慢但不该算在假人头上的两种情况</span>
        </div>
        <div class="config-field">
            <span>跨图次数 <em>本次进程</em></span>
            <strong>@Perf.MapChanges.ToString("N0")</strong>
            <span class="field-note">真的换了地图才算，不是「决定要走」的次数</span>
        </div>
        <div class="config-field">
            <span>发言条数 <em>本次进程</em></span>
            <strong>@Perf.Chats.ToString("N0")</strong>
            <span class="field-note">真的发出去才算</span>
        </div>
        <div class="config-field">
            <span>金币产出 <em>本次在线</em></span>
            <strong>@Overview.GoldPerHour.ToString("N0") /时</strong>
            <span class="field-note">累计 @Overview.GoldEarned.ToString("N0")</span>
        </div>
        <div class="config-field">
            <span>全局熔断 <em>BotBreaker</em></span>
            <strong style="@(Perf.BreakerOpen ? "color:var(--red);" : "")">@Perf.BreakerText</strong>
            <span class="field-note">本次触发 @Perf.BreakerTripCount 次 · 最近 @Perf.BreakerOpenedText</span>
        </div>
    </div>

    @* 传送参数必须和行内「传送」按钮同屏 —— 放在「上线管理」tab 里时，
       点按钮的人看不到自己会传去哪，等于闭着眼睛点。 *@
    <AuthorizeView Policy="@AdminPermissions.PolicyOperate">
        <div class="teleport-bar">
            <span class="teleport-label">传送目标</span>
            <select @bind="_teleportMapIndex" class="teleport-map">
                @foreach (BotMapOption option in _mapOptions)
                {
                    <option value="@option.Index">@option.ToString()</option>
                }
            </select>
            <input type="number" @bind="_teleportX" placeholder="X" class="teleport-xy" />
            <input type="number" @bind="_teleportY" placeholder="Y" class="teleport-xy" />
            <span class="teleport-hint">行内「传送」按钮用这张图 + 坐标（X/Y 都要 &gt; 0）</span>
        </div>
    </AuthorizeView>

    @if (Rows.Length == 0)
    {
        <p style="opacity:.75;">
            @(Overview.SchedulerStarted ? "调度器还没有产出快照，稍等一两秒。" : "调度器未启动（游戏服务器未运行或未初始化）。")
        </p>
    }
    else
    {
        <div class="table-panel standalone">
            <div class="table-scroll">
                <table class="admin-table bot-live-table">
                    <thead>
                        <tr>
                            <th style="width:40px;">#</th>
                            <th style="width:110px;">角色</th>
                            <th style="width:52px;">职业</th>
                            <th style="width:62px;">等级</th>
                            <th style="width:96px;">HP</th>
                            <th style="width:88px;">MP</th>
                            <th style="width:110px;">地图</th>
                            <th style="width:76px;">坐标</th>
                            <th style="width:88px;">状态</th>
                            <th style="width:56px;">击杀</th>
                            <th style="width:52px;">复活</th>
                            <th style="width:66px;">在线</th>
                            <th style="width:86px;">金币</th>
                            <th style="width:104px;">负重</th>
                            <th style="width:86px;">装备持久</th>
                            <th style="width:96px;">最近技能</th>
                            <th style="width:180px;">最近动作 / 最后错误</th>
                            <th style="width:196px;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (BotSnapshot row in Rows)
                        {
                            BotSnapshot capturedRow = row;

                            @* 整行可点：点开就是照片 2-1 那个角色详情弹窗（P5-3）。
                               操作列必须 stopPropagation，否则点「踢下线」会顺手弹窗。 *@
                            <tr style="@RowStyle(row);cursor:pointer;" title="点这一行看角色详情"
                                @onclick="() => OpenDetail(capturedRow)">
                                <td>@row.Seq</td>
                                <td>@row.CharacterName</td>
                                <td>@ClassText(row.ClassName)</td>
                                <td>
                                    <div class="cell-stack">
                                        <b>@row.Level</b>
                                        <small>@(row.ExpPercent)%</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-stack">
                                        <b>@row.CurrentHealth / @row.MaxHealth</b>
                                        <span class="bar hp @HpBarClass(row.HealthPercent)"><i style="width:@BarWidth(row.HealthPercent)"></i></span>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-stack">
                                        <b>@row.CurrentMana / @row.MaxMana</b>
                                        <span class="bar mp"><i style="width:@BarWidth(row.ManaPercent)"></i></span>
                                    </div>
                                </td>
                                <td>@row.MapName</td>
                                <td>@row.X, @row.Y</td>
                                <td>
                                    <span class="state-pill @StatePillClass(row)"><i></i>@StateText(row.State)</span>
                                </td>
                                <td>@row.Kills</td>
                                <td>@row.Deaths</td>
                                <td>@(string.IsNullOrEmpty(row.OnlineFor) ? "—" : row.OnlineFor)</td>
                                <td>@row.Gold.ToString("N0")</td>
                                <td>
                                    <div class="cell-stack">
                                        <b class="@WeightClass(row)">@row.BagWeight / @row.MaxBagWeight</b>
                                        <small>@row.BagWeightPercent% · @row.UsedSlots/@row.SlotCount 格</small>
                                        <span class="bar weight @WeightBarClass(row)"><i style="width:@BarWidth(Math.Min(100, row.BagWeightPercent))"></i></span>
                                    </div>
                                </td>
                                <td>
                                    @if (row.WorstDurabilityPercent < 0)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <div class="cell-stack">
                                            <b class="@(row.WorstDurabilityPercent <= 20 ? "text-danger" : row.WorstDurabilityPercent <= 50 ? "text-warn" : "")">@row.WorstDurabilityPercent%</b>
                                            <small>@SlotText(row.WorstDurabilitySlot)</small>
                                        </div>
                                    }
                                </td>
                                @* 技能名已在 BotBrain 落库时用 BotText.Magic 翻成中文，这里不再维护第二份映射表。 *@
                                <td>@(string.IsNullOrEmpty(row.LastMagic) ? "—" : row.LastMagic)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(row.LastError))
                                    {
                                        <span class="text-danger">@row.LastError</span>
                                    }
                                    else
                                    {
                                        @row.Detail
                                    }
                                </td>
                                <td @onclick:stopPropagation="true">
                                    @if (row.IsOnline)
                                    {
                                        <div style="display:flex;gap:4px;flex-wrap:wrap;">
                                            <RadzenButton Text="补给" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => Restock(row.Seq))" Disabled="@(!_canOperate)" />
                                            <RadzenButton Text="传送" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => Teleport(row.Seq))" Disabled="@(!_canOperate)" />
                                            <RadzenButton Text="踢下线" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Warning"
                                                          Click="@(() => Kick(row.Seq))" Disabled="@(!_canOperate)" />
                                            @if (_canOwner && row.ClassName != "Warrior")
                                            {
                                                <RadzenButton Text="技能自检" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger"
                                                              Click="@(() => SkillCheck(row.Seq))" />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="display:flex;gap:4px;flex-wrap:wrap;">
                                            <RadzenButton Text="启停" Size="ButtonSize.ExtraSmall"
                                                          ButtonStyle="@(row.Enabled ? ButtonStyle.Light : ButtonStyle.Primary)"
                                                          Click="@(() => ToggleOne(row))" Disabled="@(!_canOperate)" />
                                            <RadzenButton Text="重置" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => ResetOne(row.Seq))" Disabled="@(!_canOperate)" />
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <p style="opacity:.6;font-size:12px;margin:10px 0 0;">
            状态胶囊：<span class="state-pill fight"><i></i>打怪</span>
            <span class="state-pill move"><i></i>赶路/补给</span>
            <span class="state-pill idle"><i></i>待机</span>
            <span class="state-pill dead"><i></i>死亡</span>
            —— 金色小字是经验进度；负重 ≥100% 时捡不了东西（引擎判定同源），要盯这张表。
        </p>
    }
}

@* ============================ 上线管理 ============================ *@
@if (_tab == TabManage)
{
    <AuthorizeView Policy="@AdminPermissions.PolicyOperate">
        <div class="control-cluster" style="margin-bottom:14px;">
            <RadzenButton Text="上 5 个" Icon="group_add" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => ForceSpawn(5))"
                          Disabled="@(GameServer.State != GameServerState.Running || !Overview.SchedulerStarted)" />
            <RadzenButton Text="撤 5 个" Icon="group_remove" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => ForceDespawn(5))"
                          Disabled="@(GameServer.State != GameServerState.Running || !Overview.SchedulerStarted)" />
            <RadzenButton Text="全部重置" Icon="restart_alt" ButtonStyle="ButtonStyle.Light"
                          Click="ResetAll"
                          Disabled="@(GameServer.State != GameServerState.Running || !Overview.SchedulerStarted)" />
        </div>

        <h2 style="margin:20px 0 8px;font-size:16px;">水位参数</h2>
        <p style="opacity:.75;font-size:13px;margin:0 0 10px;">
            改完点「保存水位」写入 <code>Server.ini</code>，下一轮调度就按新值执行，<b>不用重启</b>。
            这里和「配置 → Bots」改的是同一份数据，在哪边改都算数。
        </p>

        <div class="water-grid">
            <div class="config-field">
                <span>目标在线 <em>BotTargetOnline</em></span>
                <input type="number" min="0" max="500" @bind="_waterTarget" />
                <span class="field-note">真人 + 假人合计；低于它补人、高于它撤人</span>
            </div>
            <div class="config-field">
                <span>下限 ~ 上限 <em>BotMin/MaxOnline</em></span>
                <div class="water-range">
                    <input type="number" min="0" max="500" @bind="_waterMin" />
                    <span>~</span>
                    <input type="number" min="0" max="500" @bind="_waterMax" />
                </div>
                <span class="field-note">水位会被夹在这个区间内</span>
            </div>
            <div class="config-field">
                <span>每轮变更 <em>BotMaxChangePerTick</em></span>
                <input type="number" min="1" max="10" @bind="_waterStep" />
                <span class="field-note">一次最多上/下几个人，越小越平滑</span>
            </div>
            <div class="config-field">
                <span>分图容量 <em>BotMapCapacity</em></span>
                <input type="number" min="1" max="50" @bind="_waterMapCapacity" />
                <span class="field-note">同一张练级图最多几个假人</span>
            </div>
        </div>

        <div class="control-cluster" style="margin:14px 0;">
            <RadzenButton Text="保存水位" Icon="save" ButtonStyle="ButtonStyle.Primary"
                          Click="SaveWatermark" />
            <RadzenButton Text="还原" Icon="undo" ButtonStyle="ButtonStyle.Light"
                          Click="LoadWatermark" />
            <span style="font-size:12px;opacity:.7;align-self:center;">
                当前生效：目标 @Config.BotTargetOnline · @Config.BotMinOnline~@Config.BotMaxOnline · 每轮 ±@Config.BotMaxChangePerTick · 分图 @Config.BotMapCapacity
            </span>
        </div>

        <h2 style="margin:24px 0 8px;font-size:16px;">
            过载熔断
            <small style="font-size:11px;font-weight:400;opacity:.6;">P4-5 · 全局，只管假人</small>
        </h2>
        <p style="opacity:.75;font-size:13px;margin:0 0 12px;line-height:1.7;">
            假人段（调度器 + 所有假人的寻路与决策）占主循环的比例<b>连续</b>超过阈值时，把水位上限<b>临时</b>压到当前在线数 ——
            <b>只停止新增，不踢在线的人</b>（玩家看到假人成批消失比看到卡顿更假）。
            假人自然下线后上限跟着降，占比回落到阈值一半以下并持续一段窗口后自动解除。
            <br />
            判据用<b>占比</b>而不是毫秒：主循环是自旋的，空闲时几千帧/秒，每帧毫秒数会被帧数稀释到接近 0，
            真实占用再高也看不出来；占比与帧率无关，直接回答「把假人拿掉服务器会不会好」。
            <br />
            <b>这个上限只在内存里，绝不写回 <c>Server.ini</c></b>，重启即还原。
            默认关闭：先在上面「假人性能」里看几天真实基线，确认阈值有余量再打开 ——
            阈值定低了误触发的现象是「假人再也不涨了」，比卡顿更难发现。
        </p>
        <div class="water-grid">
            <div class="config-field">
                <span>启用熔断 <em>BotBreakerEnabled</em></span>
                <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;">
                    <input type="checkbox" @bind="_breakerEnabled" />
                    <span>@(_breakerEnabled ? "已启用" : "未启用（观察期）")</span>
                </label>
                <span class="field-note">观察期就是现在：只有数据没有动作</span>
            </div>
            <div class="config-field">
                <span>阈值 <em>BotBreakerSharePercent</em></span>
                <input type="number" min="1" max="100" @bind="_breakerSharePercent" />
                <span class="field-note">假人段占主循环的百分比上限；当前实测 @Perf.BotSharePercent.ToString("0.#")%</span>
            </div>
            <div class="config-field">
                <span>触发窗口 <em>BotBreakerTripSeconds</em></span>
                <input type="number" min="5" max="600" @bind="_breakerTripSeconds" />
                <span class="field-note">连续超标多少秒才触发；太小会被单次存库尖峰误触发</span>
            </div>
            <div class="config-field">
                <span>恢复窗口 <em>BotBreakerRecoverSeconds</em></span>
                <input type="number" min="5" max="600" @bind="_breakerRecoverSeconds" />
                <span class="field-note">回落到阈值一半以下并持续多少秒才解除</span>
            </div>
        </div>

        <div class="control-cluster" style="margin:14px 0;">
            <RadzenButton Text="保存熔断设置" Icon="save" ButtonStyle="ButtonStyle.Primary"
                          Click="SaveBreaker" />
            <RadzenButton Text="还原" Icon="undo" ButtonStyle="ButtonStyle.Light"
                          Click="LoadWatermark" />
            <RadzenButton Text="立即解除熔断" Icon="lock_open" ButtonStyle="ButtonStyle.Warning"
                          Click="ResetBreaker" Disabled="@(!Perf.BreakerOpen)" />
            <span style="font-size:12px;opacity:.7;align-self:center;">
                当前生效：@(Config.BotBreakerEnabled ? "启用" : "关闭") · @Config.BotBreakerSharePercent% /
                @Config.BotBreakerTripSeconds s / @Config.BotBreakerRecoverSeconds s
                @if (Perf.BreakerOpen)
                {
                    <b style="color:var(--red);"> · 上限已压到 @Perf.BreakerCeiling</b>
                }
            </span>
        </div>
    </AuthorizeView>

    <div class="config-grid" style="margin-bottom:14px;padding:0;">
        <div class="config-field"><span>调度器</span><strong>@(Overview.SchedulerStarted ? "运行中" : "未启动")</strong></div>
        <div class="config-field"><span>停用 / 故障</span><strong>@Overview.Disabled / @Overview.Broken</strong></div>
        <div class="config-field"><span>主循环延迟（Con / Save）</span><strong>@Overview.ConnectionDelayMs ms / @Overview.SaveDelayMs ms</strong></div>
    </div>

    <h2 style="margin:22px 0 8px;font-size:16px;">假人档案（跨重启持久化）</h2>
    <p style="opacity:.75;font-size:13px;margin:0 0 10px;">
        下面这张表读的是 <code>Users.db</code> 里的角色记录，<b>不依赖在线状态</b>：
        假人下线、服务器重启之后，等级、累计击杀、累计在线时长都还在（真人角色这些列恒为 0）。
    </p>

    @if (Profiles.Count == 0)
    {
        <p style="opacity:.75;">
            @(Overview.SchedulerStarted ? "还没有假人档案（假人尚未建号，或服务器未运行）。" : "调度器未启动（游戏服务器未运行或未初始化）。")
            @if (!string.IsNullOrEmpty(Admin.LastProfileError))
            {
                <br />
                <b style="color:var(--red);">读取失败：@Admin.LastProfileError</b>
            }
        </p>
    }
    else
    {
        <div class="table-panel standalone">
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th style="width:44px;">#</th>
                            <th style="width:120px;">角色</th>
                            <th style="width:56px;">职业</th>
                            <th style="width:70px;">等级</th>
                            <th style="width:110px;">经验</th>
                            <th style="width:64px;">累计击杀</th>
                            <th style="width:96px;">累计在线</th>
                            <th style="width:96px;">补给 成/败</th>
                            <th style="width:64px;">成功率</th>
                            <th style="width:80px;">用卷/买卷</th>
                            <th style="width:80px;">交易/挖取</th>
                            <th style="width:64px;">金币</th>
                            <th style="width:56px;">装备</th>
                            <th style="width:56px;">状态</th>
                            <th style="width:120px;">位置</th>
                            <th style="width:130px;">上次登录</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (BotProfileRow row in Profiles)
                        {
                            <tr>
                                <td>@row.Seq</td>
                                <td>@row.CharacterName</td>
                                <td>@ClassText(row.ClassName)</td>
                                <td>@row.Level</td>
                                <td>@row.ExpPercent%</td>
                                <td>@row.Kills</td>
                                <td>@row.OnlineTimeText</td>
                                <td>@row.Restocks / @row.RestockFails</td>
                                <td>@row.RestockRateText</td>
                                <td>@row.TownScrollUses / @row.TownScrollBuys</td>
                                <td>@row.Trades / @row.Harvests</td>
                                <td>@row.Gold.ToString("N0")</td>
                                <td>@row.Items</td>
                                <td>@(row.Online ? "在线" : "离线")</td>
                                <td>@row.MapName</td>
                                <td>@row.LastLoginText</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <AuthorizeView Policy="@AdminPermissions.PolicyOwner">
        <h2 style="margin:22px 0 8px;font-size:16px;">假人数据清理</h2>
        <p style="opacity:.75;font-size:13px;margin:0 0 10px;">
            按账号上的 <code>IsBot</code> 标记精确删除<b>假人账号、角色及其全部关联数据</b>（背包 / 仓库 / 货币 / 宠物 / 邮件 / 寄售 / 任务等），
            <b>真人账号一个都不碰</b>。这是不可逆操作，执行前会先给出预览；清理期间调度器会被停用。
        </p>

        <div class="table-panel standalone" style="padding:12px;">
            @if (_cleanupPreview is null)
            {
                <RadzenButton Text="预览将清理的数据" Icon="preview" ButtonStyle="ButtonStyle.Light"
                              Click="PreviewCleanup" Disabled="@(!ServerRunning)" />
            }
            else
            {
                <div style="margin-bottom:10px;line-height:1.9;">
                    @* 原本文案只显示「已下线可立即删」的账号数，30 个假人全在线时会显示「0 个假人账号」，
                       看起来像查不到数据，运维不敢点。这里把在线数合并进总数，并说明拆分。 *@
                    将清理：<b>@(_cleanupPreview.Accounts + _cleanupPreview.Online)</b> 个假人账号
                    @if (_cleanupPreview.Online > 0)
                    {
                        <span>（已下线 <b>@_cleanupPreview.Accounts</b> 个可立即删，在线 <b>@_cleanupPreview.Online</b> 个会先下线再删）</span>
                    }
                    、<b>@_cleanupPreview.Characters</b> 个角色、
                    物品 <b>@_cleanupPreview.Items</b>、货币记录 <b>@_cleanupPreview.Currencies</b>、
                    宠物 <b>@_cleanupPreview.Companions</b>、邮件 <b>@_cleanupPreview.Mails</b>、
                    寄售 <b>@_cleanupPreview.Auctions</b>、任务 <b>@_cleanupPreview.Quests</b>。
                </div>

                @if (!_cleanupConfirming)
                {
                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                        <RadzenButton Text="清理并停用调度" Icon="delete_forever" ButtonStyle="ButtonStyle.Danger"
                                      Click="@(() => RunCleanup(false))" Disabled="@(!ServerRunning)" />
                        <RadzenButton Text="重置（清完重新开号）" Icon="restart_alt" ButtonStyle="ButtonStyle.Warning"
                                      Click="@(() => RunCleanup(true))" Disabled="@(!ServerRunning)" />
                        <RadzenButton Text="取消" ButtonStyle="ButtonStyle.Light" Click="CancelCleanup" />
                    </div>
                }
                else
                {
                    <div class="alert danger" style="margin-bottom:8px;">
                        <b>最后确认：</b>此操作会永久删除上面列出的全部假人数据，无法撤销。
                        清理后假人调度会@(_cleanupResumeScheduler ? "恢复，假人重新建号并从 1 级开始" : "保持停用，假人不再上线")。确定继续吗？
                    </div>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                        <RadzenButton Text="确定删除" Icon="check_circle" ButtonStyle="ButtonStyle.Danger" Click="ConfirmCleanup" />
                        <RadzenButton Text="我再想想" ButtonStyle="ButtonStyle.Light" Click="CancelCleanup" />
                    </div>
                }
            }
        </div>
    </AuthorizeView>

    <div style="margin-top:18px;opacity:.75;font-size:13px;line-height:1.75;">
        <p>
            <strong>阶段</strong>：建连接 → 等待入列 → 登录中 → 进图中 → 在线。四个前段每步之间随机停 300~1200ms，
            避免 30 个假人同一帧涌进来把主循环顶住。
        </p>
        <p>
            <strong>行为</strong>：待机 / 去刷怪点 / 打怪 / 捡东西 / 等复活 / 回城买药 / 回城卖货 / 挖取 / 跨图赶路 / 传送跨图。
            法师道士<b>按引擎等级门槛补技能</b>（火球术 7 级、灵魂火符 13 级），1~6 级只有平砍 —— 与真人一致。
        </p>
        <p>
            <strong>操作边界</strong>：单人「启停 / 重置 / 补给 / 传送 / 踢下线」不写审计（一秒能点十次）；
            「关闭总开关」「全部重置」「清理假人」各写一条。「清理假人」是<b>不可逆</b>的删号操作，
            只有主密码登录可见，执行前必须先看预览。
        </p>
        <p>
            <strong>数据存哪</strong>：假人与真人共用同一个 <code>Users.db</code>，靠账号上的 <code>IsBot</code> 标记区分。
            假人账号<b>不接受外部登录</b>（密码是固定值，登录会触发顶号保护甚至把账号封禁）。
            <code>Users.db</code> 是唯一的数据文件，<b>删了等于清档</b>（真人和假人一起没）。
        </p>
    </div>
}

@* ============================ 配置文件 ============================ *@
@if (_tab == TabFiles)
{
    <div class="config-grid" style="padding:0 0 16px;">
        <div class="config-field">
            <span>名单文件 <em>Bots/names.txt</em></span>
            <strong>@_nameCount 条</strong>
            <span style="color:#6d7d82;">@(string.IsNullOrEmpty(_namesPath) ? "未找到" : _namesPath)</span>
        </div>
        <div class="config-field">
            <span>聊天语料 <em>Bots/chat.txt</em></span>
            <strong>@_chatCount 条</strong>
            <span style="color:#6d7d82;">格式：类别|地图|等级下限|文本</span>
        </div>
        <div class="config-field">
            <span>生效方式</span>
            <strong style="font-weight:400;">改文件保存后 <b>5 秒内热加载</b>，不用重启、不用重启调度</strong>
        </div>
    </div>

    <div class="alert warning" style="margin-bottom:14px;">
        这两个文件<b>不提供在线编辑</b>：它们是纯文本（UTF-8 / CRLF），在线编辑会把中文编码和换行改坏，
        而坏掉的语料不会报错，只会让假人「突然不说话了」。请用编辑器改服务器目录下的文件。
    </div>

    <h2 style="margin:18px 0 8px;font-size:16px;">当前生效参数（只读）</h2>
    <p style="opacity:.75;font-size:13px;margin:0 0 10px;">
        改这些要去「配置 → Bots」，保存后即时生效。这里只是让运营不用来回跳页就能确认现值。
    </p>

    <div class="readonly-grid">
        <div><span>BotEnabled</span><b>@Config.BotEnabled</b></div>
        <div><span>水位 目标/最小/最大</span><b>@Config.BotTargetOnline / @Config.BotMinOnline / @Config.BotMaxOnline</b></div>
        <div><span>每轮变更上限</span><b>@Config.BotMaxChangePerTick</b></div>
        <div><span>分图容量</span><b>@Config.BotMapCapacity</b></div>
        <div><span>日志级别</span><b>@Config.BotLogLevel</b></div>
        <div><span>聊天</span><b>@(Config.BotChatEnabled ? "开" : "关") @Config.BotChatIntervalMinSeconds~@Config.BotChatIntervalMaxSeconds 秒</b></div>
        <div><span>社交总开关</span><b>@(Config.BotSocialEnabled ? "开" : "关")</b></div>
        <div><span>行会</span><b>@(Config.BotGuildEnabled ? "开" : "关") · @Config.BotGuildCount 个 · ≥@Config.BotGuildMinLevel 级</b></div>
        <div><span>红名 PK</span><b>@(Config.BotPkEnabled ? "开" : "关") · 每 @Config.BotPkIntervalMinutes 分钟</b></div>
        <div><span>榜首降速</span><b>@(Config.BotTopSlowEnabled ? "开" : "关") · 前 @Config.BotTopRankLimit 名 / @Config.BotTopHoldMinutes 分钟后停 @Config.BotTopSlowMinutes 分钟</b></div>
        <div><span>真人优先 / 跳过 BOSS</span><b>@(Config.BotRespectRealPlayerTags ? "开" : "关") / @(Config.BotSkipBoss ? "开" : "关")</b></div>
        <div>
            <span>夜间比例</span>
            <b>
                @(Config.BotNightEnabled ? Config.BotNightScalePercent + "%（" + Config.BotNightMinHour + "~" + Config.BotNightMaxHour + " 点）" : "关")
                @if (Overview.NightActive)
                {
                    <em style="font-style:normal;color:var(--amber,#b8860b);"> · 当前生效中</em>
                }
                <small style="font-weight:400;opacity:.6;"> 按服务器本机时区（现在 @NightClockText）</small>
            </b>
        </div>
    </div>
}

@* ============================ 运行日志 ============================ *@
@if (_tab == TabLogs)
{
    <div class="control-cluster" style="margin-bottom:10px;">
        <div class="config-field" style="min-width:150px;">
            <span>假人</span>
            <select @bind="_logSeqFilter" @bind:after="RefreshLogs">
                <option value="0">全部</option>
                @foreach (int seq in _logSeqOptions)
                {
                    <option value="@seq">BOT#@seq.ToString("D2")</option>
                }
            </select>
        </div>
        <div class="config-field" style="min-width:130px;">
            <span>级别</span>
            <select @bind="_logLevelFilter" @bind:after="RefreshLogs">
                <option value="">全部</option>
                <option value="DEBUG">Debug</option>
                <option value="INFO">Info</option>
                <option value="WARN">Warn</option>
                <option value="ERROR">Error</option>
            </select>
        </div>
        <RadzenButton Text="@(_logPaused ? "恢复滚动" : "暂停滚动")"
                      Icon="@(_logPaused ? "play_arrow" : "pause")"
                      ButtonStyle="@(_logPaused ? ButtonStyle.Success : ButtonStyle.Light)"
                      Click="ToggleLogPause" />
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <p style="opacity:.7;font-size:12px;margin:0;">
            只显示含 <code>BOT#</code> / <code>BOT</code> 的系统日志（最多最近 300 条）。要完整日志去服务器目录的 <code>Logs.txt</code>。
        </p>
        <span class="text-muted" style="font-size:11px;">
            @_logLines.Length 条@(_logPaused && _logPending > 0 ? $" · 暂停中，新增 {_logPending} 条未显示" : "")
        </span>
    </div>

    @if (_logLines.Length == 0)
    {
        <p style="opacity:.75;">
            @(_logSeqFilter > 0 || !string.IsNullOrEmpty(_logLevelFilter)
                ? "当前筛选条件下没有日志，换个条件试试。"
                : "还没有假人日志。把 BotLogLevel 调成 1（Info）或 0（Debug）能看到更多。")
        </p>
    }
    else
    {
        <div class="log-console">
            @foreach (string line in _logLines)
            {
                <div class="log-line"><span>·</span>@line</div>
            }
        </div>
    }
}

@* ============================ 角色详情弹窗（P5-3） ============================ *@
@if (_detailOpen)
{
    @* tabindex + FocusAsync 是必须的：焦点不在这个容器上时 @onkeydown 收不到 Esc（见任务清单 §8.7 坑 3）。 *@
    <div class="bot-modal-mask" tabindex="0" @ref="_detailRoot"
         @onkeydown="OnDetailKeyDown" @onclick="CloseDetail">
        <div class="bot-modal" @onclick:stopPropagation="true">

            <div class="bot-modal-head">
                <div class="bot-modal-title">
                    <b>@(_detail?.CharacterName ?? "—")</b>
                    <span>@ClassText(_detail?.ClassName ?? string.Empty)</span>
                    <span class="dot">·</span>
                    <span>Lv @(_detail?.Level ?? 0)</span>
                    <span class="dot">·</span>
                    <span>@(_detail?.MapName ?? "—")</span>
                    @if (_detail != null)
                    {
                        <span class="text-muted" style="font-size:11px;margin-left:6px;">@_detail.X, @_detail.Y</span>
                    }
                </div>
                <button class="bot-modal-close" @onclick="CloseDetail">关闭 (Esc)</button>
            </div>

            <div class="bot-modal-tabs">
                <button class="@(_detailTab == 0 ? "active" : "")" @onclick="() => _detailTab = 0">角色</button>
                <button class="@(_detailTab == 1 ? "active" : "")" @onclick="() => _detailTab = 1">属性</button>
            </div>

            @if (_detail == null)
            {
                <p style="opacity:.75;padding:24px 4px;">
                    @(_detailSeq <= 0 ? "" : "这个假人当前不在线（还没拿到角色对象），看不到详情。")
                </p>
            }
            else if (_detailTab == 0)
            {
                <div class="bot-detail-body">

                    @* ---------- 左：纸娃娃 ---------- *@
                    <div class="doll-panel">
                        <div class="doll-name">@_detail.CharacterName <span class="doll-heart">❤</span></div>

                        <div class="doll-canvas" style="width:@(DollPixelWidth)px;height:@(DollPixelHeight)px;">

                            @* 人体轮廓：只做视觉参照，不参与任何逻辑（真角色精灵要在客户端才能渲染）。 *@
                            <svg class="doll-body" viewBox="0 0 100 160" preserveAspectRatio="xMidYMid meet">
                                <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="50" cy="17" r="8.5" />
                                    <path d="M50 26 L50 34" />
                                    <path d="M36 40 Q50 33 64 40 L66 70 Q50 76 34 70 Z" />
                                    <path d="M36 41 L27 66 L24 92" />
                                    <path d="M64 41 L73 66 L76 92" />
                                    <path d="M42 74 L41 112 L39 150" />
                                    <path d="M58 74 L59 112 L61 150" />
                                </g>
                            </svg>

                            @foreach (BotDetailSlot slot in _detail.Slots)
                            {
                                BotDetailSlot captured = slot;

                                <button class="doll-slot @(IsSelectedSlot(slot) ? "selected" : "") @(slot.HasItem ? "filled" : "empty")"
                                        style="left:@(SlotLeft(slot))px;top:@(SlotTop(slot))px;width:@(DollCell)px;height:@(DollCell)px;"
                                        title="@SlotTitle(slot)"
                                        @onclick="() => SelectSlot(captured)">
                                    @if (slot.HasItem)
                                    {
                                        <img src="@ItemIconUrl(slot.Image)" alt="@slot.ItemName" loading="lazy" />
                                        @if (slot.HasDurability && slot.DurabilityPercent <= 20)
                                        {
                                            <i class="doll-worn"></i>
                                        }
                                    }
                                    else
                                    {
                                        <span class="doll-slot-text">@SlotText(slot.SlotName)</span>
                                    }
                                </button>
                            }
                        </div>

                        <p class="doll-hint">点槽位看物品详情 · 红点 = 持久 ≤20%</p>
                    </div>

                    @* ---------- 右：物品卡 ---------- *@
                    <aside class="item-card">
                        @if (_detailSlot == null)
                        {
                            <div class="item-card-empty">点左边的槽位查看这件装备的详细属性。</div>
                        }
                        else if (!_detailSlot.HasItem)
                        {
                            <div class="item-card-empty">
                                <b>@SlotText(_detailSlot.SlotName)</b><br />
                                这个槽位是空的。
                            </div>
                        }
                        else
                        {
                            <div class="item-card-head">
                                <img src="@ItemIconUrl(_detailSlot.Image)" alt="@_detailSlot.ItemName" />
                                <div>
                                    <b>@_detailSlot.ItemName</b>
                                    <small>@SlotText(_detailSlot.SlotName) · @_detailSlot.TypeName</small>
                                </div>
                            </div>

                            <div class="item-card-rows">
                                <div><span>需求等级</span><b>Lv @_detailSlot.RequiredLevel</b></div>

                                @if (_detailSlot.HasDurability)
                                {
                                    <div>
                                        <span>持久</span>
                                        <b class="@DurabilityClass(_detailSlot.DurabilityPercent)">
                                            @_detailSlot.CurrentDurability / @_detailSlot.MaxDurability
                                        </b>
                                    </div>
                                    <div class="item-card-bar">
                                        <span class="bar dura @DurabilityBarClass(_detailSlot.DurabilityPercent)">
                                            <i style="width:@BarWidth(_detailSlot.DurabilityPercent)"></i>
                                        </span>
                                    </div>
                                }

                                @if (_detailSlot.EnhanceLevel > 0)
                                {
                                    <div><span>强化</span><b class="text-gold">+@_detailSlot.EnhanceLevel</b></div>
                                }

                                <div><span>重量</span><b>@_detailSlot.Weight</b></div>
                                <div><span>价格</span><b>@_detailSlot.Price.ToString("N0")</b></div>

                                @if (!string.IsNullOrEmpty(_detailSlot.FlagsText))
                                {
                                    <div><span>标记</span><b class="text-warn">@_detailSlot.FlagsText</b></div>
                                }
                            </div>

                            @if (_detailSlot.Stats.Count > 0)
                            {
                                <div class="item-card-stats">
                                    <h4>基础属性</h4>
                                    @foreach (BotDetailLine line in _detailSlot.Stats)
                                    {
                                        <div><span>@line.Title</span><b>@line.Value</b></div>
                                    }
                                </div>
                            }
                        }
                    </aside>
                </div>
            }
            else
            {
                @* ---------- 属性 tab ---------- *@
                <div class="bot-detail-body">
                    <div class="detail-summary">
                        <div><span>HP</span><b>@_detail.CurrentHealth / @_detail.MaxHealth</b></div>
                        <div><span>MP</span><b>@_detail.CurrentMana / @_detail.MaxMana</b></div>
                        <div><span>金币</span><b>@_detail.Gold.ToString("N0")</b></div>
                        <div><span>负重</span><b>@_detail.BagWeight / @_detail.MaxBagWeight</b></div>
                        <div><span>背包</span><b>@_detail.UsedSlots / @_detail.SlotCount 格</b></div>
                        <div><span>击杀 / 复活</span><b>@_detail.Kills / @_detail.Deaths</b></div>
                    </div>

                    @if (_detail.Attributes.Count == 0)
                    {
                        <p style="opacity:.7;padding:8px 4px;">这个角色当前没有任何属性条目。</p>
                    }
                    else
                    {
                        <div class="detail-attrs">
                            @foreach (BotDetailLine line in _detail.Attributes)
                            {
                                <div><span>@line.Title</span><b>@line.Value</b></div>
                            }
                        </div>
                    }
                </div>
            }

            <div class="bot-modal-foot">
                <span>@(_detail == null ? "" : $"更新 {_detail.SnapshotAt:HH:mm:ss} · 每 5 秒自动刷新")</span>
                <span>@(_detail == null ? "" : _detail.Detail)</span>
            </div>
        </div>
    </div>
}

@code {
    private const int TabOverview = 0;
    private const int TabManage = 1;
    private const int TabFiles = 2;
    private const int TabLogs = 3;

    private int _tab = TabOverview;

    private BotSnapshot[] Rows { get; set; } = Array.Empty<BotSnapshot>();
    private BotOverview Overview { get; set; } = BotOverview.Empty;

    /// <summary>性能指标（P4-5）：帧耗时 / 熔断状态 / 跨图与发言计数。</summary>
    private BotPerf Perf { get; set; } = BotPerf.Empty;

    /// <summary>假人档案（跨重启持久化的历史数据）。</summary>
    private IReadOnlyList<BotProfileRow> Profiles { get; set; } = Array.Empty<BotProfileRow>();

    private BotMapOption[] _mapOptions = Array.Empty<BotMapOption>();
    private int _teleportMapIndex;
    private int _teleportX;
    private int _teleportY;

