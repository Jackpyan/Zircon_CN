                <RadzenButton Text="开始自检" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger"
                              Click="ConfirmSkillCheck" />
            </div>
        </div>
    </div>
}

@code {
    private const int TabOverview = 0;
    private const int TabManage = 1;
    private const int TabFiles = 2;
    private const int TabLogs = 3;

    private int _tab = TabOverview;

    private BotSnapshot[] Rows { get; set; } = Array.Empty<BotSnapshot>();

    /// <summary>假人列表的自定义过滤关键字（2026-11-18，空 = 不过滤）。</summary>
    private string _botFilter = string.Empty;

    /// <summary>
    /// 过滤后的假人列表：序号 / 角色 / 职业 / 地图 / 状态 / 最近动作 / 最后错误，
    /// 任意字段包含关键字即命中（忽略大小写）。
    /// </summary>
    private IEnumerable<BotSnapshot> FilteredRows
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_botFilter)) return Rows;

            string q = _botFilter.Trim();

            return Rows.Where(r =>
                r.Seq.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                || (r.CharacterName ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase)
                || ClassText(r.ClassName ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase)
                || (r.ClassName ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase)
                || (r.MapName ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase)
                || (r.State ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase)
                || (r.Phase ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase)
                || (r.Detail ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase)
                || (r.LastError ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }
