    /// <summary>点「清理并停用」/「重置」：第一次只进入确认态，并把用户选的模式记下来。</summary>
    private void RunCleanup(bool resumeScheduler)
    {
        _cleanupConfirming = true;
        _cleanupResumeScheduler = resumeScheduler;
    }

    /// <summary>点「确定删除」：按用户之前选的模式真正执行。</summary>
    private async Task ConfirmCleanup()
    {
        _cleanupConfirming = false;

        BotCommandResult result = await Admin.CleanupBotsAsync(_user, null, _cleanupResumeScheduler);

        _cleanupPreview = null;

        Report(result);
    }

    private static string RowStyle(BotSnapshot row)
    {
        if (row.Broken) return "background:rgba(220,53,69,.10);";
        if (!row.Enabled) return "opacity:.55;";
        return string.Empty;
    }

    private static string ShortPath(string path)
    {
        // 只给运营看「Bots/names.txt」，前面一长串安装路径没意义。
        int index = path.Replace('\\', '/').LastIndexOf("/Bots/", StringComparison.Ordinal);

        return index >= 0 ? path.Substring(index + 1) : path;
    }

    private async Task ToggleEnabled()
    {
        BotCommandResult result = await Admin.SetEnabledAsync(!Overview.Enabled, _user, null);

        Report(result);
    }

    #region P5-4 水位参数

    /// <summary>
    /// 把当前生效值填回输入框。
    /// <para>
    /// 只在首屏和「还原」时调用 —— <see cref="Refresh"/> 每 2 秒跑一次，如果在里面覆盖，
    /// 运营正在输入的数字会被刷掉。
    /// </para>
    /// </summary>
    private void LoadWatermark()
    {
        _waterTarget = Config.BotTargetOnline;
        _waterMin = Config.BotMinOnline;
        _waterMax = Config.BotMaxOnline;
        _waterStep = Config.BotMaxChangePerTick;
        _waterMapCapacity = Config.BotMapCapacity;

        _breakerEnabled = Config.BotBreakerEnabled;
        _breakerSharePercent = Config.BotBreakerSharePercent;
        _breakerTripSeconds = Config.BotBreakerTripSeconds;
        _breakerRecoverSeconds = Config.BotBreakerRecoverSeconds;
    }

    /// <summary>
    /// 保存水位：走 <see cref="ConfigurationService.Save"/>，和「配置」页同一条路径 ——
    /// 它负责写 <c>Server.ini</c>、刷新 <see cref="Config"/>、失败回滚，并记一条
    /// <c>Configuration.Save</c> 审计。这里不自己写文件，否则审计和回滚都会漏。
    /// </summary>
    private async Task SaveWatermark()
    {
        if (_waterMin < 0 || _waterMax < _waterMin)
        {
            Report(BotCommandResult.Fail($"下限/上限不合法：{_waterMin} ~ {_waterMax}（上限不能小于下限）"));
            return;
        }

        if (_waterTarget < _waterMin || _waterTarget > _waterMax)
        {
            Report(BotCommandResult.Fail($"目标 {_waterTarget} 不在 {_waterMin} ~ {_waterMax} 之间"));
            return;
        }

        if (_waterStep <= 0 || _waterMapCapacity <= 0)
        {
            Report(BotCommandResult.Fail("每轮变更上限与分图容量都必须大于 0"));
            return;
        }

        Dictionary<string, string?> values = new()
        {
            [nameof(Config.BotTargetOnline)] = _waterTarget.ToString(),
            [nameof(Config.BotMinOnline)] = _waterMin.ToString(),
            [nameof(Config.BotMaxOnline)] = _waterMax.ToString(),
            [nameof(Config.BotMaxChangePerTick)] = _waterStep.ToString(),
            [nameof(Config.BotMapCapacity)] = _waterMapCapacity.ToString(),
        };

        try
        {
            string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

            ConfigurationManager.Save(values, user);

            Report(BotCommandResult.Success(
                $"水位已保存：目标 {Config.BotTargetOnline}（{Config.BotMinOnline}~{Config.BotMaxOnline}）、" +
                $"每轮 ±{Config.BotMaxChangePerTick}、分图容量 {Config.BotMapCapacity}。下一轮调度生效。"));
        }
        catch (Exception ex)
        {
            Report(BotCommandResult.Fail($"保存失败：{ex.Message}"));
        }
    }

    #endregion

    #region P4-5 过载熔断

    /// <summary>
    /// 保存熔断设置。和 <see cref="SaveWatermark"/> 一样走 <see cref="ConfigurationService.Save"/>，
    /// 单独一个方法而不是合并进去：两块设置在页面上是两个区块、两个按钮，
    /// 合并保存会让「只改熔断」的人莫名其妙地把水位也重写一遍（还会多一条审计）。
    /// </summary>
    private async Task SaveBreaker()
    {
        if (_breakerSharePercent <= 0 || _breakerSharePercent > 100)
        {
            Report(BotCommandResult.Fail("熔断阈值必须在 1 ~ 100 之间（占主循环的百分比）"));
            return;
        }

        if (_breakerTripSeconds <= 0 || _breakerRecoverSeconds <= 0)
        {
            Report(BotCommandResult.Fail("触发窗口与恢复窗口都必须大于 0 秒"));
            return;
        }

        Dictionary<string, string?> values = new()
        {
            [nameof(Config.BotBreakerEnabled)] = _breakerEnabled ? "True" : "False",
            [nameof(Config.BotBreakerSharePercent)] = _breakerSharePercent.ToString(),
            [nameof(Config.BotBreakerTripSeconds)] = _breakerTripSeconds.ToString(),
            [nameof(Config.BotBreakerRecoverSeconds)] = _breakerRecoverSeconds.ToString(),
        };

        try
        {
            string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

            ConfigurationManager.Save(values, user);

            Report(BotCommandResult.Success(
                $"熔断设置已保存：{(_breakerEnabled ? "启用" : "关闭")}、" +
                $"{Config.BotBreakerSharePercent}% / {Config.BotBreakerTripSeconds} s / {Config.BotBreakerRecoverSeconds} s。下一轮评估生效。"));
        }
        catch (Exception ex)
        {
            Report(BotCommandResult.Fail($"保存失败：{ex.Message}"));
        }
    }

