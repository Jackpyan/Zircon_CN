    #region P5-8 新号与运行参数

    /// <summary>
    /// 保存「新号与运行参数」。和 <see cref="SaveWatermark"/> 一样走
    /// <see cref="ConfigurationManager.Save"/>，理由也一样：写文件、刷 <see cref="Config"/>、
    /// 失败回滚、记 <c>Configuration.Save</c> 审计，四件事都在它里面，自己写文件必漏。
    /// </summary>
    private async Task SaveBotParams()
    {
        if (_newbieGold < 0 || _newbieGold > 100000000)
        {
            Report(BotCommandResult.Fail("启动金币必须在 0 ~ 1 亿之间"));

            return;
        }

        if (_newbiePotion < 0 || _newbiePotion > 200 || _newbieScroll < 0 || _newbieScroll > 50)
        {
            Report(BotCommandResult.Fail("启动药水要在 0 ~ 200 之间、回城卷要在 0 ~ 50 之间"));

            return;
        }

        if (_rampSeconds < 1 || _rosterInterval < 1)
        {
            Report(BotCommandResult.Fail("冷启动铺量间隔与水位重算间隔都必须 ≥ 1 秒"));

            return;
        }

        if (_stepMinMs < 0 || _stepMaxMs < _stepMinMs)
        {
            Report(BotCommandResult.Fail($"上线分步间隔不合法：{_stepMinMs} ~ {_stepMaxMs}（上限不能小于下限）"));

            return;
        }

        if (_logLevel < 0 || _logLevel > 3)
        {
            Report(BotCommandResult.Fail("日志级别只能是 0~3（Debug/Info/Warn/Error）"));

            return;
        }

        if (_restockLow < 0 || _buyRed < 0 || _buyBlue < 0 || _buyTownScroll < 0)
        {
            Report(BotCommandResult.Fail("补给阈值与购买数量都不能是负数"));

            return;
        }

        if (_nightMin < 0 || _nightMin > 23 || _nightMax < 0 || _nightMax > 23)
        {
            Report(BotCommandResult.Fail("夜间时段必须在 0 ~ 23 点之间"));

            return;
        }

        if (_nightEnabled && _nightMin == _nightMax)
        {
            Report(BotCommandResult.Fail("夜间时段起止不能相同（相同等于不启用，请直接关掉开关）"));

            return;
        }

        if (_nightScale < 1 || _nightScale > 100)
        {
            Report(BotCommandResult.Fail("夜间比例必须在 1 ~ 100 之间"));

            return;
        }

        Dictionary<string, string?> values = new()
        {
            [nameof(Config.BotNewbieGold)] = _newbieGold.ToString(),
            [nameof(Config.BotNewbiePotionCount)] = _newbiePotion.ToString(),
            [nameof(Config.BotNewbieTownScrollCount)] = _newbieScroll.ToString(),
            [nameof(Config.BotStartupRampSeconds)] = _rampSeconds.ToString(),
            [nameof(Config.BotRosterIntervalSeconds)] = _rosterInterval.ToString(),
            [nameof(Config.BotStepDelayMinMs)] = _stepMinMs.ToString(),
            [nameof(Config.BotStepDelayMaxMs)] = _stepMaxMs.ToString(),
            [nameof(Config.BotLogLevel)] = _logLevel.ToString(),
            [nameof(Config.BotRestockPotionLow)] = _restockLow.ToString(),
            [nameof(Config.BotRestockBuyRed)] = _buyRed.ToString(),
            [nameof(Config.BotRestockBuyBlue)] = _buyBlue.ToString(),
            [nameof(Config.BotRestockBuyTownScroll)] = _buyTownScroll.ToString(),
            [nameof(Config.BotNightEnabled)] = _nightEnabled ? "True" : "False",
            [nameof(Config.BotNightMinHour)] = _nightMin.ToString(),
            [nameof(Config.BotNightMaxHour)] = _nightMax.ToString(),
            [nameof(Config.BotNightScalePercent)] = _nightScale.ToString(),
        };

        // 5000 金就是用户踩过的坑：连一趟跨图传送都不够，跨图只能退化成 A* 走，
        // 洞穴图一绕就规划失败。不拦住（有人可能故意配 0），但必须在成功提示里点出来。
        string hint = _newbieGold > 0 && _newbieGold < 10000
            ? $"（注意：{_newbieGold:N0} 金连一趟跨图传送都不够，新号会「没钱」走不动）"
            : string.Empty;

        await SaveConfigAsync(values,
            $"假人参数已保存：金币 {_newbieGold:N0}、药 {_newbiePotion}、卷 {_newbieScroll}、" +
            $"日志 {_logLevel}、夜间 {(_nightEnabled ? _nightScale + "%" : "关")}。{hint}下一轮生效。");
    }

