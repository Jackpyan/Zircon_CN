    /// <summary>
    /// 统一保存入口：把 <see cref="ConfigurationService.Save"/> 挪到线程池上执行。
    /// <para>
    /// 为什么必须挪：它是同步的（反射 Config 全部属性 → 重写 Server.ini →
    /// 给客户端 exe 算 SHA256 → 同步追加审计 jsonl）。放在电路线程上直接调，
    /// 首次点击会出现「整页僵住几秒」（2026-11-13 用户实测，见 <see cref="_saving"/> 的注释）。
    /// </para>
    /// <para>
    /// 副作用是安全的：<c>Save</c> 只写静态 <see cref="Config"/> 字段 + 文件，
    /// 和游戏线程之间本来就没有锁依赖（改配置从来不需要停服）。
    /// </para>
    /// </summary>
    private async Task SaveConfigAsync(Dictionary<string, string?> values, string successMessage)
    {
        if (_saving) return;

        _saving = true;

        // 必须立刻重绘一次：Blazor 要等事件处理器**整体返回**才渲染，
        // 不主动 StateHasChanged 的话，「保存中…」要等到保存完才出现 —— 等于没有。
        StateHasChanged();

        try
        {
            string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

            await Task.Run(() => ConfigurationManager.Save(values, user));

            Report(BotCommandResult.Success(successMessage));
        }
        catch (Exception ex)
        {
            Report(BotCommandResult.Fail($"保存失败：{ex.Message}"));
        }
        finally
        {
            _saving = false;
        }
    }

