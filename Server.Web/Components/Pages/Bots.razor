    /// <summary>状态胶囊配色：打怪绿、赶路/补给琥珀、死亡红、待机灰。</summary>
    private static string StatePillClass(BotSnapshot row)
    {
        if (row.Broken) return "broken";

        return row.State switch
        {
            "Fight" => "fight",
            "Loot" => "fight",
            "Dead" => "dead",
            "GoHunt" => "move",
            "Travel" => "move",
            "Teleport" => "move",
            "Restock" => "move",
            "Trade" => "move",
            "Harvest" => "move",
            "Rebirth" => "move",
            _ => "idle",
        };
    }

    private static string HpBarClass(int percent) => percent <= 30 ? "crit" : percent <= 60 ? "low" : string.Empty;

    private static string WeightClass(BotSnapshot row) =>
        row.BagWeightPercent >= 100 ? "text-danger" : row.BagWeightPercent >= 85 ? "text-warn" : string.Empty;

    private static string WeightBarClass(BotSnapshot row) =>
        row.BagWeightPercent >= 100 ? "over" : row.BagWeightPercent >= 85 ? "near" : string.Empty;

    /// <summary>进度条宽度：钳到 0~100，防止 120% 负重把条撑出格子。</summary>
    private static string BarWidth(int percent) => Math.Clamp(percent, 0, 100) + "%";

