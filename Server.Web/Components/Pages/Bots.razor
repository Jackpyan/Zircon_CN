                <div class="bot-modal-title">
                    <b>技能自检 BOT#@(_skillCheckSeq.ToString("00"))</b>
                </div>
                <button class="bot-modal-close" @onclick="CloseSkillCheck">关闭 (Esc)</button>
            </div>

            <div style="padding:14px 16px;">
                <p style="opacity:.75;font-size:12.5px;margin:0 0 12px;">
