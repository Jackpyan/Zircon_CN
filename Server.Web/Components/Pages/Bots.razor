    private CancellationTokenSource? _refreshCts;

    private bool ServerRunning => Admin.ServerRunning;

    /// <summary>
    /// 服务器本机时间（作息判据看的就是它）。
    /// 显示出来是为了让运营一眼确认「夜间缩水按哪个时区算」—— 判据曾经错用 UTC 小时，
    /// 页面上有这个时钟就能当场看出对不对。
    /// </summary>
    private static string NightClockText => DateTime.Now.ToString("HH:mm");

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        _user = state.User;
        _canOperate = AdminPermissions.CanOperate(state.User);
        _canOwner = AdminPermissions.CanOwner(state.User);

        _tab = ViewQuery switch
        {
            "manage" => TabManage,
            "files" => TabFiles,
            "logs" => TabLogs,
            _ => TabOverview,
        };

        Refresh();
        LoadWatermark();

        // 首屏就把假人档案拉出来（走游戏线程排队）。
        // 之前只靠刷新循环里的第 0 个 tick 去取，而 SSR 预渲染那一刻 Profiles 必然是空数组 ——
        // 于是首屏永远显示「还没有假人档案」，看起来就像表坏了（2026-11-13 排查）。
        Profiles = await Admin.GetProfilesAsync();

        // 地图下拉只在首屏取一次（244 条，静态数据）。
        _mapOptions = Admin.MapOptions().ToArray();

        if (_mapOptions.Length > 0) _teleportMapIndex = _mapOptions[0].Index;

        // 深链直接开详情（/bots?detail=5）。
        if (DetailSeq.HasValue && DetailSeq.Value > 0)
        {
            _detailOpen = true;
            _detailSeq = DetailSeq.Value;
            _detailTab = DetailTabQuery == 1 ? 1 : 0;
            _detailFocusPending = true;

            await LoadDetailAsync();
        }

        _refreshCts = new CancellationTokenSource();
        _ = RefreshLoopAsync(_refreshCts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 弹窗是 tabindex 容器，必须真的拿到焦点，@onkeydown 才收得到 Esc。
        if (!_detailFocusPending) return;

        _detailFocusPending = false;

        try
        {
            await _detailRoot.FocusAsync();
        }
        catch
        {
            // 弹窗在这一次渲染里已经被关掉时 FocusAsync 会抛，忽略即可。
        }
    }

    private void Refresh()
    {
        Rows = Admin.GetSnapshot();
        Overview = Admin.GetOverview();
        Perf = Admin.GetPerf();

        var files = Admin.DataFiles();
        _namesPath = files.Path;
        _nameCount = files.Count;
        _chatCount = files.ChatCount;

        // 日志只在「运行日志」tab 打开时才过滤，别在别的 tab 白烧 CPU。
        if (_tab == TabLogs) RefreshLogs();
    }

    private void RefreshLogs()
    {
        IReadOnlyList<string> all = Logs.GetSystemLogs();

        // 先粗筛出假人日志，再按开关细分。粗筛结果的总数用于算「暂停期间新增」。
        List<string> bot = all
            .Where(x => x.Contains("BOT#", StringComparison.Ordinal) || x.Contains("BOT ", StringComparison.Ordinal))
            .ToList();

        if (_logPaused)
        {
            _logPending = Math.Max(0, bot.Count - _logLastTotal);
            return;
        }

        _logLastTotal = bot.Count;
        _logPending = 0;

        IEnumerable<string> query = bot;

        if (_logSeqFilter > 0)
        {
            // 日志里的标签是定宽两位（BOT#01），所以按 "BOT#01" 精确匹配，
            // 不能用 "BOT#1" —— 那样会把 BOT#10~#19 一起捞进来。
            string tag = $"BOT#{_logSeqFilter:D2}";
            query = query.Where(x => x.Contains(tag, StringComparison.Ordinal));
        }

        if (!string.IsNullOrEmpty(_logLevelFilter))
        {
            // 行内格式是 "[08:09:40.128] BOT#06 [WARN ] ..."，级别标签带对齐空格，
            // 所以只匹配前缀 "[WARN" 而不是完整 "[WARN ]"。
            string tag = "[" + _logLevelFilter;
            query = query.Where(x => x.Contains(tag, StringComparison.Ordinal));
        }

        _logLines = query.TakeLast(300).ToArray();

        // 序号下拉跟着在线名单走；把当前筛的那个也留着，否则它一下线，
        // 下拉里没有对应 option，界面会显示成空白。
        _logSeqOptions = Rows
            .Select(x => x.Seq)
            .Concat(_logSeqFilter > 0 ? new[] { _logSeqFilter } : Array.Empty<int>())
            .Distinct()
            .OrderBy(x => x)
            .ToArray();
    }

    private void ToggleLogPause()
    {
        _logPaused = !_logPaused;

        if (_logPaused) return;

        // 恢复滚动：一次性追平（RefreshLogs 会清掉 _logPending）。
        RefreshLogs();
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        int tick = 0;

        while (!token.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(2000, token);

                // 档案要遍历全部假人账号读库，比在线快照重 —— 每 5 个 tick（10 秒）刷一次就够了。
                bool refreshProfiles = tick++ % 5 == 0;

                IReadOnlyList<BotProfileRow> profiles = refreshProfiles
                    ? await Admin.GetProfilesAsync(token)
                    : Profiles;

                await InvokeAsync(() =>
                {
                    if (refreshProfiles) Profiles = profiles;

                    Refresh();
                    StateHasChanged();
                });

                // 详情弹窗：点开时拉一次，之后每 5 秒刷一次。
                // 别跟着 2 秒的主循环走 —— 详情要走游戏线程，频率高了会白占主循环时间。
                if (_detailOpen && (DateTime.UtcNow - _detailLoadedAt).TotalSeconds >= 5)
                {
                    await InvokeAsync(LoadDetailAsync);
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (TaskCanceledException)
            {
                return;
            }
            catch (Exception ex)
            {
                // 一次取数失败不能把整个刷新循环打死 —— 原先这里是裸 `return`，
                // 只要有一轮抛异常，页面就永久停在首屏那份快照上，
                // 现象是「档案表一直空 / 在线数不再跳」，而日志里一个字都没有。
                Admin.ReportRefreshError(ex);

                try
                {
                    await Task.Delay(5000, token);
                }
                catch (TaskCanceledException)
                {
                    return;
                }
            }
        }
    }

    private async Task PreviewCleanup()
    {
