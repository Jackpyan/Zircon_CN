    /// <summary>老路径：一张张 png（图集不可用时的兜底）。<c>Image</c> 为负说明这件物品没配图标。</summary>
    private static string ItemIconUrl(int image) => image < 0 ? string.Empty : $"/icons/items/{image}.png";

    /// <summary>
    /// 画一个物品图标。
    /// <para>
    /// 首选<b>图集</b>（<see cref="ItemIconAtlas"/>）：<c>icons/items/atlas.png</c> 里一格一张，
    /// 用 <c>background-position</c> 定位，部署目录里就只有 2 个文件而不是 700 多个。
    /// 图集缺失/没收录这个序号时，退回老的「一张张 png」——老部署不重跑 iconpack 也不会变成一片空白。
    /// </para>
    /// </summary>
    private static RenderFragment ItemIcon(int image, string alt) => builder =>
    {
        if (image < 0) return;

        if (ItemIconAtlas.TryGet(image, out int col, out int row))
        {
            int cell = ItemIconAtlas.Cell;

            builder.OpenElement(0, "i");
            builder.AddAttribute(1, "class", "item-ic");
            builder.AddAttribute(2, "title", alt);
            builder.AddAttribute(3, "style",
                $"background-position:{-col * cell}px {-row * cell}px;" +
                $"background-size:{ItemIconAtlas.Width}px {ItemIconAtlas.Height}px;");
            builder.CloseElement();

            return;
        }

        builder.OpenElement(4, "img");
        builder.AddAttribute(5, "src", ItemIconUrl(image));
        builder.AddAttribute(6, "alt", alt);
        builder.AddAttribute(7, "loading", "lazy");
        builder.AddAttribute(8, "onerror", "this.style.display='none'");
        builder.CloseElement();
    };

    private static string DurabilityClass(int percent) =>
        percent <= 20 ? "text-danger" : percent <= 50 ? "text-warn" : string.Empty;

    private static string DurabilityBarClass(int percent) =>
