    /// 单独一个方法而不是合并进去：两块设置在页面上是两个区块、两个按钮，
    /// 合并保存会让「只改熔断」的人莫名其妙地把水位也重写一遍（还会多一条审计）。
    /// </summary>
    private async Task SaveBreaker()
    {
        if (_breakerSharePercent <= 0 || _breakerSharePercent > 100)
        {
            Report(BotCommandResult.Fail("熔断阈值必须在 1 ~ 100 之间（占主循环的百分比）"));
            return;
        }

        if (_breakerTripSeconds <= 0 || _breakerRecoverSeconds <= 0)
        {
            Report(BotCommandResult.Fail("触发窗口与恢复窗口都必须大于 0 秒"));
            return;
        }

        Dictionary<string, string?> values = new()
        {
            [nameof(Config.BotBreakerEnabled)] = _breakerEnabled ? "True" : "False",
            [nameof(Config.BotBreakerSharePercent)] = _breakerSharePercent.ToString(),
            [nameof(Config.BotBreakerTripSeconds)] = _breakerTripSeconds.ToString(),
            [nameof(Config.BotBreakerRecoverSeconds)] = _breakerRecoverSeconds.ToString(),
        };

        await SaveConfigAsync(values,
            $"熔断设置已保存：{(_breakerEnabled ? "启用" : "关闭")}、" +
            $"{_breakerSharePercent}% / {_breakerTripSeconds} s / {_breakerRecoverSeconds} s。下一轮评估生效。");
    }

