    #region 练级地图白名单

    /// <summary>当前生效的白名单图数（0 = 不限制）。</summary>
    private int HuntMapCount() => BotOptions.ParseIndexes(Config.BotHuntMaps).Count;

    /// <summary>
    /// 按等级段重算白名单，只出预览不落盘。
    /// <para>
    /// 为什么不直接写：白名单写错的后果是「假人原地不动」且只有 Debug 日志，
    /// 留一步人工确认，顺便让分段明细能被人看一眼。
    /// </para>
    /// </summary>
    private async Task PlanHuntMaps()
    {
        if (_huntPlanning) return;

        _huntPlanning = true;
        StateHasChanged();

        try
        {
            (HuntMapPlan? plan, string? error) = await Admin.PlanHuntMapsAsync();

            if (error != null || plan == null)
            {
                Report(BotCommandResult.Fail(error ?? "重算失败：结果为空"));
                return;
            }

            _huntPlan = plan;

            Report(BotCommandResult.Success(
                $"重算完成：1~{Config.MaxLevel} 级共需 {plan.Indices.Count} 张图（预览未保存，确认后点「保存白名单」）"));
        }
        finally
        {
            _huntPlanning = false;
        }
    }

    private async Task SaveHuntMaps()
    {
        if (_huntPlan == null) return;

        HuntMapPlan plan = _huntPlan;

        // 先清预览再存：存成功就没什么可保存的了；存失败会由 SaveConfigAsync 报错，
        // 预览留着反而让人以为「没存进去但已经生效」。
        _huntPlan = null;

        await SaveConfigAsync(
            new Dictionary<string, string?> { [nameof(Config.BotHuntMaps)] = plan.Csv },
            $"练级白名单已保存：{plan.Indices.Count} 张图。下一轮选图立即按新名单执行（不用重启）。");
    }

