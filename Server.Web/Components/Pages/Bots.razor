                </p>

                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                    <label for="skillCheckLevelInput" style="font-size:13px;">目标等级</label>
                    <input id="skillCheckLevelInput" type="number" min="1" max="@Config.MaxLevel"
                           autofocus="true"
                           @bind="_skillCheckLevelText"
                           placeholder="1 ~ @Config.MaxLevel"
                           style="width:140px;padding:5px 8px;" />
                    <span style="opacity:.6;font-size:12px;">范围 1 ~ @Config.MaxLevel</span>
