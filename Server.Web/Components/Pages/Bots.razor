    /// <summary>纸娃娃的缩放系数：客户端格子是 28×28，放大 1.6 倍才好点。</summary>
    private const double DollScale = 1.75;

    /// <summary>格子的像素边长。</summary>
    private static int DollCell => (int)Math.Round(28 * DollScale);

    private static int DollPixelWidth => (int)Math.Round(BotDetail.DollWidth * DollScale);

    private static int DollPixelHeight => (int)Math.Round(BotDetail.DollHeight * DollScale);

    /// <summary>弹窗是否打开（和 <see cref="_detail"/> 分开：打开的那一刻详情还在路上）。</summary>
    private bool _detailOpen;

    /// <summary>当前正在看哪个假人（0 = 没开）。</summary>
    private int _detailSeq;

    private BotDetail? _detail;

    /// <summary>0 = 角色 tab，1 = 属性 tab。</summary>
    private int _detailTab;

    /// <summary>当前选中的槽位（null = 还没点）。</summary>
    private BotDetailSlot? _detailSlot;

    /// <summary>上次拉详情的时刻，用来做 5 秒节流（见任务清单 §8.7 坑 2）。</summary>
    private DateTime _detailLoadedAt;

    /// <summary>
    /// 深链：<c>/bots?detail=5</c> 直接打开 5 号假人的详情。
    /// <para>运营可以把某个人的详情直接发给别人；自动化验证也靠它拿到真实渲染的弹窗 HTML。</para>
    /// </summary>
    [SupplyParameterFromQuery(Name = "detail")]
    private int? DetailSeq { get; set; }

    /// <summary>深链直接落到某个 tab：<c>/bots?detail=5&amp;tab=1</c> 打开「属性」。</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    private int? DetailTabQuery { get; set; }

    /// <summary>
    /// 深链直接打开某个页面 tab：<c>/bots?view=manage</c>。
    /// <para>
    /// 和 <see cref="DetailTabQuery"/> 分开命名 —— 那个是弹窗内的「角色/属性」，
    /// 两者都用 <c>tab</c> 会互相覆盖。运营可以把某个 tab 存成书签。
    /// </para>
    /// </summary>
    [SupplyParameterFromQuery(Name = "view")]
    private string? ViewQuery { get; set; }

    private ElementReference _detailRoot;

    /// <summary>弹窗刚打开，等下一帧渲染完再把焦点抢过来，否则 Esc 收不到。</summary>
    private bool _detailFocusPending;

    private async Task OpenDetail(BotSnapshot row)
    {
        _detailOpen = true;
        _detailSeq = row.Seq;
        _detailTab = 0;
        _detailSlot = null;
        _detail = null;
        _detailFocusPending = true;

        await LoadDetailAsync();
    }

    private void CloseDetail()
    {
        _detailOpen = false;
        _detailSeq = 0;
        _detail = null;
        _detailSlot = null;
    }

    private async Task LoadDetailAsync()
    {
        if (_detailSeq <= 0) return;

        BotDetail? detail = await Admin.GetDetailAsync(_detailSeq);

        // 拉的过程中用户可能已经关掉 / 换了人，别把过期数据贴回去。
        if (!_detailOpen || detail == null || detail.Seq != _detailSeq)
        {
            if (_detailOpen && detail == null) _detail = null;
            return;
        }

        bool firstLoad = _detail == null;

        // 选中槽位要跟着新数据换一份引用，否则卡片会一直显示旧对象。
        if (_detailSlot != null)
        {
            int index = _detailSlot.Index;

            _detailSlot = detail.Slots.FirstOrDefault(x => x.Index == index) ?? _detailSlot;
        }

        _detail = detail;

        // 首次打开默认选中武器（和游戏里角色窗口一致，卡片也不会一上来就是空的）。
        // 只在首次生效：用户主动点了同一个槽位取消选中后，5 秒刷新不该又给他选回去。
        if (firstLoad && _detailSlot == null)
            _detailSlot = DefaultSlot(detail);

        _detailLoadedAt = DateTime.UtcNow;
    }

    /// <summary>默认选中的槽位：优先武器，没有武器就挑第一个穿了装备的。</summary>
    private static BotDetailSlot? DefaultSlot(BotDetail detail)
    {
        BotDetailSlot? weapon = detail.Slots.FirstOrDefault(x => x.SlotName == "Weapon" && x.HasItem);

        if (weapon != null) return weapon;

        return detail.Slots.FirstOrDefault(x => x.HasItem);
    }

    private void SelectSlot(BotDetailSlot slot)
    {
        // 再点一次同一个槽位 = 取消选中（和客户端点格子开/关的体验一致）。
        _detailSlot = _detailSlot != null && _detailSlot.Index == slot.Index ? null : slot;
    }

    private void OnDetailKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseDetail();
    }

    private bool IsSelectedSlot(BotDetailSlot slot) => _detailSlot != null && _detailSlot.Index == slot.Index;

    private static int SlotLeft(BotDetailSlot slot) => (int)Math.Round(slot.X * DollScale);

    private static int SlotTop(BotDetailSlot slot) => (int)Math.Round((slot.Y - BotDetail.DollTop) * DollScale);

    private static string SlotTitle(BotDetailSlot slot) =>
        slot.HasItem
            ? $"{slot.ItemName}（{SlotText(slot.SlotName)}）{slot.DurabilityPercent}%"
            : SlotText(slot.SlotName);

    /// <summary>图标静态路径。<c>Image</c> 为负说明这件物品没配图标，返回空串让 img 自然不显示。</summary>
    private static string ItemIconUrl(int image) => image < 0 ? string.Empty : $"/icons/items/{image}.png";

    private static string DurabilityClass(int percent) =>
        percent <= 20 ? "text-danger" : percent <= 50 ? "text-warn" : string.Empty;

    private static string DurabilityBarClass(int percent) =>
        percent <= 20 ? "crit" : percent <= 50 ? "low" : string.Empty;

