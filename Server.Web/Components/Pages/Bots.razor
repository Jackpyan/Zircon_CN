    /// <summary>
    /// 保存水位：走 <see cref="ConfigurationService.Save"/>，和「配置」页同一条路径 ——
    /// 它负责写 <c>Server.ini</c>、刷新 <see cref="Config"/>、失败回滚，并记一条
    /// <c>Configuration.Save</c> 审计。这里不自己写文件，否则审计和回滚都会漏。
    /// </summary>
    private async Task SaveWatermark()
    {
        if (_waterMin < 0 || _waterMax < _waterMin)
        {
            Report(BotCommandResult.Fail($"下限/上限不合法：{_waterMin} ~ {_waterMax}（上限不能小于下限）"));
            return;
        }

        if (_waterTarget < _waterMin || _waterTarget > _waterMax)
        {
            Report(BotCommandResult.Fail($"目标 {_waterTarget} 不在 {_waterMin} ~ {_waterMax} 之间"));
            return;
        }

        if (_waterStep <= 0 || _waterMapCapacity <= 0)
        {
            Report(BotCommandResult.Fail("每轮变更上限与分图容量都必须大于 0"));
            return;
        }

        Dictionary<string, string?> values = new()
        {
            [nameof(Config.BotTargetOnline)] = _waterTarget.ToString(),
            [nameof(Config.BotMinOnline)] = _waterMin.ToString(),
            [nameof(Config.BotMaxOnline)] = _waterMax.ToString(),
            [nameof(Config.BotMaxChangePerTick)] = _waterStep.ToString(),
            [nameof(Config.BotMapCapacity)] = _waterMapCapacity.ToString(),
        };

        await SaveConfigAsync(values,
            $"水位已保存：目标 {_waterTarget}（{_waterMin}~{_waterMax}）、" +
            $"每轮 ±{_waterStep}、分图容量 {_waterMapCapacity}。下一轮调度生效。");
    }

