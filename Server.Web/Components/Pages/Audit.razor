@page "/audit"
@attribute [Authorize]
@inject AdminAuditService AuditService

<PageTitle>审计记录 · Zircon</PageTitle>

<div class="page-heading compact">
    <div>
        <span class="eyebrow">安全 / 审计</span>
        <h1>管理操作审计</h1>
        <p>按天落盘（保留 90 天），页面显示最近 2,000 条；支持按操作者 / 操作 / 结果 / 关键字筛选与导出。</p>
    </div>
    <div class="control-cluster">
        <a class="rz-button rz-button-md rz-variant-filled rz-primary" href="/audit/export" target="_blank">导出 CSV</a>
    </div>
</div>

<div class="config-grid" style="margin-bottom:12px;">
    <label class="config-field">
        <span>操作者</span>
        <input value="@_userFilter" @onchange="e => { _userFilter = e.Value?.ToString(); }" placeholder="账号 / admin" />
    </label>
    <label class="config-field">
        <span>操作</span>
        <input value="@_actionFilter" @onchange="e => { _actionFilter = e.Value?.ToString(); }" placeholder="Login / Configuration.Save" />
    </label>
    <label class="config-field">
        <span>结果</span>
        <select value="@_resultFilter" @onchange="e => { _resultFilter = e.Value?.ToString(); }">
            <option value="">全部</option>
            <option value="Success">成功</option>
            <option value="Failed">失败</option>
            <option value="Denied">无权限</option>
        </select>
    </label>
    <label class="config-field">
        <span>关键字</span>
        <input value="@_keyword" @onchange="e => { _keyword = e.Value?.ToString(); }" placeholder="详情 / 来源 / 原因" />
    </label>
</div>

<section class="legacy-grid-shell">
    <RadzenDataGrid Data="@FilteredEntries" TItem="AdminAuditEntry" AllowPaging="true" PageSize="50"
                    AllowSorting="true" AllowColumnResize="true" Density="Density.Compact" Class="legacy-data-grid audit-grid"
                    EmptyText="暂无审计记录" PagingSummaryFormat="第 {0}–{1} 条，共 {2} 条"
                    FirstPageTitle="首页" FirstPageAriaLabel="转到首页" PrevPageTitle="上一页" PrevPageAriaLabel="转到上一页"
                    NextPageTitle="下一页" NextPageAriaLabel="转到下一页" LastPageTitle="末页" LastPageAriaLabel="转到末页"
                    PageTitleFormat="第 {0} 页" PageAriaLabelFormat="转到第 {0} 页">
        <Columns>
            <RadzenDataGridColumn TItem="AdminAuditEntry" Property="Timestamp" Title="时间" Width="185px" Frozen="true" />
            <RadzenDataGridColumn TItem="AdminAuditEntry" Property="User" Title="操作者" Width="150px" />
            <RadzenDataGridColumn TItem="AdminAuditEntry" Property="Role" Title="身份" Width="130px">
                <Template Context="entry">@UiText.AuditRole(entry.Role)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AdminAuditEntry" Property="Action" Title="操作" Width="200px">
                <Template Context="entry">@UiText.AuditAction(entry.Action)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AdminAuditEntry" Property="Result" Title="结果" Width="90px">
                <Template Context="entry">@UiText.AuditResult(entry.Result)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AdminAuditEntry" Property="Detail" Title="详情">
                <Template Context="entry">@UiText.AuditDetail(entry.Detail)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AdminAuditEntry" Property="Reason" Title="原因" Width="170px">
                <Template Context="entry">@UiText.AuditReason(entry.Reason)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AdminAuditEntry" Property="Address" Title="来源 IP" Width="140px" />
        </Columns>
    </RadzenDataGrid>
</section>

@code {
    private string? _userFilter;
    private string? _actionFilter;
    private string? _resultFilter;
    private string? _keyword;

    private IReadOnlyList<AdminAuditEntry> FilteredEntries
    {
        get
        {
            IEnumerable<AdminAuditEntry> entries = AuditService.GetEntries();

            if (!string.IsNullOrWhiteSpace(_userFilter))
                entries = entries.Where(x => x.User.Contains(_userFilter.Trim(), StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(_actionFilter))
                entries = entries.Where(x => x.Action.Contains(_actionFilter.Trim(), StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(_resultFilter))
                entries = entries.Where(x => string.Equals(x.Result, _resultFilter, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(_keyword))
            {
                string key = _keyword.Trim();
                entries = entries.Where(x =>
                    (x.Detail?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Address?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Reason?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Target?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return entries.ToList();
        }
    }
}
