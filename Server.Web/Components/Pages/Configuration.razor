@page "/configuration"
@attribute [Authorize(Policy = AdminPermissions.PolicyManage)]
@inject ConfigurationService ConfigurationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>服务器配置 · Zircon</PageTitle>

<div class="page-heading compact">
    <div>
        <span class="eyebrow">运行 / 服务器配置文件</span>
        <h1>服务器配置</h1>
        <p>敏感值留空表示保持原值；端口和主机修改后需重启进程。</p>
    </div>
    <div class="control-cluster">
        <RadzenButton Text="重新载入" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="Reload" />
        <RadzenButton Text="检查客户端版本" Icon="fact_check" ButtonStyle="ButtonStyle.Light" Click="CheckVersion" />
        @if (_canOwner)
        {
            <RadzenButton Text="本地同步" Icon="sync" ButtonStyle="ButtonStyle.Light" Click="LocalSync" />
        }
        @if (_canOwner)
        {
            <RadzenButton Text="远程同步" Icon="cloud_sync" ButtonStyle="ButtonStyle.Light" Click="RemoteSync" />
        }
        @if (_canOwner)
        {
            <RadzenButton Text="生成加密密钥" Icon="key" ButtonStyle="ButtonStyle.Light" Click="GenerateKey" />
        }
        @if (_canOwner)
        {
            <RadzenButton Text="转换数据库加密" Icon="enhanced_encryption" ButtonStyle="ButtonStyle.Light" Click="Reencrypt" />
        }
        <RadzenButton Text="保存配置" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="Save" />
    </div>
</div>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert @(HasError ? "danger" : "success")">@Message</div>
}

<div class="config-sections">
    @foreach (ConfigurationSectionModel configSection in Sections)
    {
        <details class="config-section" open="@(configSection.Name is "Network" or "System" or "AdminWeb")">
            <summary><span>@configSection.DisplayName</span><small>@configSection.Fields.Count 项</small></summary>
            <div class="config-grid">
                @foreach (ConfigurationField field in configSection.Fields)
                {
                    <label class="config-field">
                        <span>@field.DisplayName <em>@field.ApplyMode</em></span>
                        @if (field.ValueType == typeof(bool))
                        {
                            <select value="@Values[field.Name]" @onchange="e => SetValue(field.Name, e.Value?.ToString())">
                                <option value="True">是</option>
                                <option value="False">否</option>
                            </select>
                        }
                        else
                        {
                            <input type="@(field.IsSecret ? "password" : "text")"
                                   value="@Values[field.Name]"
                                   placeholder="@(field.IsSecret ? "留空保持原值" : null)"
                                   @onchange="e => SetValue(field.Name, e.Value?.ToString())" />
                        }
                    </label>
                }
            </div>
        </details>
    }
</div>

@code {
    private IReadOnlyList<ConfigurationSectionModel> Sections = [];
    private Dictionary<string, string?> Values = new(StringComparer.Ordinal);
    private string? Message;
    private bool HasError;

    /// <summary>按钮级权限（二期）：加密/密钥/同步 = 主密码管理员专属。</summary>
    private bool _canOwner;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canOwner = AdminPermissions.CanOwner(state.User);

        LoadValues();
    }

    private void LoadValues()
    {
        Sections = ConfigurationManager.Read();
        Values = Sections.SelectMany(section => section.Fields).ToDictionary(field => field.Name, field => (string?)field.Value);
    }

    private void SetValue(string name, string? value) => Values[name] = value;

    private async Task Save()
    {
        try
        {
            string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
            ConfigurationManager.Save(Values, user);
            HasError = false;
            Message = "Server.ini 已保存。带重启标记的配置将在对应服务重启后生效。";
            LoadValues();
        }
        catch (Exception ex) { HasError = true; Message = ex.Message; }
    }

    private async Task Reload()
    {
        string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
        ConfigurationManager.Reload(user);
        LoadValues();
        HasError = false;
        Message = "已从 Server.ini 重新载入。";
    }

    private async Task Run(Func<string, CancellationToken, Task> action, string success)
    {
        try
        {
            string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
            await action(user, CancellationToken.None);
            HasError = false;
            Message = success;
        }
        catch (Exception ex) { HasError = true; Message = ex.Message; }
    }

    private async Task CheckVersion()
    {
        string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
        bool changed = await ConfigurationManager.CheckClientVersionAsync(user);
        HasError = false;
        Message = changed ? "客户端版本哈希已变化，在线玩家已收到更新公告。" : "客户端版本哈希没有变化。";
    }

    private Task LocalSync() => RunOwner(ConfigurationManager.LocalSyncAsync, "System.db 已同步到客户端 Data 目录。");
    private Task RemoteSync() => RunOwner(ConfigurationManager.RemoteSyncAsync, "System.db 已同步到远程服务器。");
    private Task Reencrypt() => RunOwner(ConfigurationManager.ReencryptDatabasesAsync, "System.db 与 Users.db 已按当前加密配置重写。");

    /// <summary>主密码专属操作守卫。</summary>
    private Task RunOwner(Func<string, CancellationToken, Task> action, string success)
    {
        if (!_canOwner)
        {
            HasError = true;
            Message = "权限不足：该操作仅限主密码登录的管理员。";
            return Task.CompletedTask;
        }

        return Run(action, success);
    }
    private void GenerateKey()
    {
        if (!_canOwner) { HasError = true; Message = "权限不足：生成加密密钥仅限主密码登录的管理员。"; return; }

        Values[nameof(Config.EncryptionKey)] = ConfigurationManager.GenerateEncryptionKey();
        Message = "已生成密钥；请先保存配置，再执行数据库加密转换。";
    }
}
