@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>管理员登录 · Zircon</PageTitle>

<div class="login-page">
    <div class="login-grid"></div>
    <section class="login-card">
        <div class="login-kicker">服务器控制台 / 身份验证</div>
        <h1>进入服务器控制平面</h1>

        @if (IsBlocked)
        {
            <div class="alert danger">登录尝试过多，已被临时封锁。请联系管理员在后台「安全 → 登录黑名单」解除，或 15 分钟后再试。</div>
        }
        else if (IsServerDown)
        {
            <div class="alert danger">
                <strong>服务器未启动，无法核对权限。</strong><br />
                请用主密码登录后台，在「服务器总览」点「启动服务器」，或让管理员启动服务进程后再登录。
            </div>
        }
        else if (IsTotpExpired)
        {
            <div class="alert danger">二次验证已过期或已使用，请重新登录。</div>
        }
        else if (HasError)
        {
            <div class="alert danger">账号或密码不正确。</div>
        }

        <form method="post" action="/auth/login" class="login-form">
            <AntiforgeryToken />
            <label>
                <span>账号</span>
                <input name="username" autocomplete="username" required autofocus />
            </label>
            <label>
                <span>密码</span>
                <input name="password" type="password" autocomplete="current-password" required />
            </label>
            <button type="submit" class="primary-action">验证并进入</button>
        </form>
        <div class="login-meta">
            <span><i class="status-light"></i> 本地管理端口</span>
            <span>HTTPS 由反向代理终止</span>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool HasError => Error == "1";
    private bool IsBlocked => Error == "2";
    /// <summary>error=3：游戏服未启动，账号库不可用，无法核对权限。</summary>
    private bool IsServerDown => Error == "3";

    /// <summary>error=4：TOTP 验证会话过期/已使用，或 TOTP 开关已关闭。</summary>
    private bool IsTotpExpired => Error == "4";

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/");
    }
}
