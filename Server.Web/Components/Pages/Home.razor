@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ServerMetricsService Metrics
@inject IGameServerController GameServer
@inject AdminAuditService Audit
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>服务器总览 · Zircon</PageTitle>

<div class="page-heading compact">
    <div>
        <span class="eyebrow">运行 / 实时运维</span>
        <h1>服务器总览</h1>
        <p>游戏循环与网络状态的只读快照，每秒刷新。</p>
    </div>
    <AuthorizeView Policy="@AdminPermissions.PolicyOwner">
        <div class="control-cluster">
            <RadzenButton Text="启动服务器" Icon="play_arrow" ButtonStyle="ButtonStyle.Primary" Click="Start" Disabled="@(!CanStart)" />
            <RadzenButton Text="停止服务器" Icon="stop" ButtonStyle="ButtonStyle.Danger" Click="Stop" Disabled="@(!CanStop)" />
        </div>
    </AuthorizeView>
</div>

@if (!string.IsNullOrEmpty(Snapshot.LastError))
{
    <div class="alert danger">@Snapshot.LastError</div>
}
@if (!string.IsNullOrEmpty(OperationMessage))
{
    <div class="alert @(OperationFailed ? "danger" : "success")">@OperationMessage</div>
}

<section class="hero-status @StateClass">
    <div>
        <span class="status-caption">游戏服务器状态</span>
        <strong>@StateText</strong>
    </div>
    <div class="pulse-track @(Snapshot.State == GameServerState.Running ? "active" : null)"><span></span></div>
    <time>@Snapshot.CapturedAt.ToString("yyyy-MM-dd HH:mm:ss")</time>
</section>

<section class="metric-grid">
    <MetricCard Label="连接" Value="@Snapshot.Connections.ToString("N0")" Unit="个客户端" Accent="cyan" />
    <MetricCard Label="活动对象" Value="@Snapshot.ActiveObjects.ToString("N0")" Unit="个活动对象" Accent="amber" />
    <MetricCard Label="对象总数" Value="@Snapshot.Objects.ToString("N0")" Unit="个对象" />
    <MetricCard Label="每秒循环" Value="@Snapshot.LoopCount.ToString("N0")" Unit="次循环" Accent="cyan" />
    <MetricCard Label="处理对象" Value="@Snapshot.ProcessedObjects.ToString("N0")" Unit="个已处理" />
    <MetricCard Label="已发送邮件" Value="@Snapshot.EmailsSent.ToString("N0")" Unit="封邮件" />
</section>

<section class="data-strip">
    <div><span>下载总量</span><strong>@FormatBytes(Snapshot.TotalBytesReceived)</strong><small>@FormatRate(Snapshot.DownloadSpeed)</small></div>
    <div><span>上传总量</span><strong>@FormatBytes(Snapshot.TotalBytesSent)</strong><small>@FormatRate(Snapshot.UploadSpeed)</small></div>
    <div><span>连接延迟</span><strong>@Snapshot.ConnectionDelayMilliseconds 毫秒</strong><small>网络</small></div>
    <div><span>保存延迟</span><strong>@Snapshot.SaveDelayMilliseconds 毫秒</strong><small>数据库</small></div>
</section>

<div class="resource-head">
    <span>主机资源</span>
    <small>每秒采样 · 整机口径（含所有进程，同 SSH 的 top）</small>
</div>

<section class="resource-grid">
    <div class="resource-cell @CpuClass">
        <span>CPU 占用</span>
        <strong>@Snapshot.CpuPercent.ToString("0.0")%</strong>
        <small>@CpuNote</small>
    </div>
    <div class="resource-cell @MemoryClass">
        <span>内存占用</span>
        <strong>@FormatBytes(Snapshot.MemoryUsedBytes)</strong>
        <small>@MemoryNote</small>
    </div>
    <div class="resource-cell">
        <span>网络流入</span>
        <strong>@FormatRate(Snapshot.NetworkReceiveBytesPerSecond)</strong>
        <small>主机网卡</small>
    </div>
    <div class="resource-cell">
        <span>网络流出</span>
        <strong>@FormatRate(Snapshot.NetworkSendBytesPerSecond)</strong>
        <small>主机网卡</small>
    </div>
    <div class="resource-cell">
        <span>运行时长</span>
        <strong>@FormatUptime(Snapshot.ProcessUptime)</strong>
        <small>服务进程</small>
    </div>
    <div class="resource-cell">
        <span>游戏服运行</span>
        <strong>@(Snapshot.GameServerUptime == TimeSpan.Zero ? "未运行" : FormatUptime(Snapshot.GameServerUptime))</strong>
        <small>本轮启动至今</small>
    </div>
</section>

@code {
    private readonly CancellationTokenSource _refreshCancellation = new();
    private ServerMetricsSnapshot Snapshot => Metrics.Current;
    private string? OperationMessage;
    private bool OperationFailed;
    private bool CanStart => Snapshot.State is GameServerState.Stopped or GameServerState.Faulted;
    private bool CanStop => Snapshot.State is GameServerState.Starting or GameServerState.Running;
    private string StateClass => Snapshot.State.ToString().ToLowerInvariant();
    private string StateText => Snapshot.State switch
    {
        GameServerState.Stopped => "已停止",
        GameServerState.Starting => "正在启动",
        GameServerState.Running => "运行中",
        GameServerState.Stopping => "正在停止",
        _ => "故障"
    };

    protected override void OnInitialized() => _ = RefreshLoop();

    private async Task RefreshLoop()
    {
        try
        {
            using PeriodicTimer timer = new(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(_refreshCancellation.Token))
                await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    /// <summary>启停服务器 = 主密码管理员专属（二期）。</summary>
    private async Task<bool> RequireOwnerAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (AdminPermissions.CanOwner(state.User)) return true;

        OperationMessage = "权限不足：启停服务器仅限主密码登录的管理员。";
        OperationFailed = true;
        return false;
    }

    private async Task Start()
    {
        if (!await RequireOwnerAsync()) return;

        try
        {
            string user = await GetUser();
            Audit.Record(user, "Server.Start", "Start requested from dashboard");
            await GameServer.StartAsync();
            OperationFailed = false;
            OperationMessage = "游戏服务器已启动。";
        }
        catch (Exception ex) { OperationFailed = true; OperationMessage = ex.ToString(); }
    }

    private async Task Stop()
    {
        if (!await RequireOwnerAsync()) return;

        try
        {
            string user = await GetUser();
            Audit.Record(user, "Server.Stop", "Stop requested from dashboard");
            await GameServer.StopAsync();
            OperationFailed = false;
            OperationMessage = "游戏服务器已停止。";
        }
        catch (Exception ex) { OperationFailed = true; OperationMessage = ex.ToString(); }
    }

    private async Task<string> GetUser() =>
        (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

    private static string FormatRate(long value) => $"{FormatBytes(value)}/s";

    /// <summary>CPU 超过 70% 变琥珀色、超过 90% 变红，扫一眼就知道要不要看。</summary>
    private string CpuClass => Snapshot.CpuPercent >= 90 ? "crit" : Snapshot.CpuPercent >= 70 ? "warn" : string.Empty;

    private string MemoryClass
    {
        get
        {
            double percent = MemoryPercent;
            return percent >= 90 ? "crit" : percent >= 80 ? "warn" : string.Empty;
        }
    }

    private double MemoryPercent => Snapshot.MemoryTotalBytes <= 0
        ? 0
        : Snapshot.MemoryUsedBytes * 100.0 / Snapshot.MemoryTotalBytes;

    private string CpuNote
    {
        get
        {
            string cores = $"{Environment.ProcessorCount} 核";
            // 负载均值只有 Linux 有；Windows 下采样器返回 0，就不显示这一段。
            string load = Snapshot.LoadAverage1 > 0 ? $" · 负载 {Snapshot.LoadAverage1:0.00}" : string.Empty;

            // 整机数字旁边带上本进程，用来回答「这台机器上到底是谁在吃 CPU」。
            return $"{cores}{load} · 进程 {Snapshot.ProcessCpuPercent:0.0}%";
        }
    }

    private string MemoryNote => Snapshot.MemoryTotalBytes <= 0
        ? "共 —"
        : $"共 {FormatBytes(Snapshot.MemoryTotalBytes)} · {MemoryPercent:0.0}% · 进程 {FormatBytes(Snapshot.ProcessMemoryBytes)}";

    private static string FormatUptime(TimeSpan value)
    {
        if (value <= TimeSpan.Zero) return "—";
        if (value.TotalDays >= 1) return $"{(int)value.TotalDays} 天 {value.Hours} 小时";
        if (value.TotalHours >= 1) return $"{(int)value.TotalHours} 小时 {value.Minutes} 分";
        if (value.TotalMinutes >= 1) return $"{(int)value.TotalMinutes} 分 {value.Seconds} 秒";
        return $"{value.Seconds} 秒";
    }

    private static string FormatBytes(long value)
    {
        string[] suffix = ["B", "KB", "MB", "GB", "TB"];
        double current = value;
        int index = 0;
        while (current >= 1024 && index < suffix.Length - 1) { current /= 1024; index++; }
        return $"{current:0.#} {suffix[index]}";
    }

    public ValueTask DisposeAsync()
    {
        _refreshCancellation.Cancel();
        _refreshCancellation.Dispose();
        return ValueTask.CompletedTask;
    }
}
