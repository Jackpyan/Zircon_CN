@attribute [Authorize]
@inject RuntimeDataService RuntimeDataManager
@inject IGameServerController GameServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService

<PageTitle>@Definition.DisplayName · Zircon</PageTitle>

<div class="page-heading compact game-data-heading">
    <div>
        <span class="eyebrow">用户数据库 / 实时快照</span>
        <h1>@Definition.DisplayName</h1>
        <p>通过游戏线程读取并受控修改运行时数据；敏感认证字段不会返回浏览器。</p>
    </div>
    <div class="view-origin"><span>原管理界面</span><strong>@Definition.DisplayName</strong></div>
</div>

@if (GameServer.State != GameServerState.Running)
{
    <div class="alert warning">游戏服务器未运行，运行时集合不可用。</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert @(HasError ? "danger" : "success")" role="status">@Message</div>
    }

    <div class="runtime-grid-layout">
        <section class="legacy-grid-shell">
            <RadzenDataGrid TItem="RuntimeDataRow" Data="@VisibleRows" AllowPaging="true" PageSize="40" AllowSorting="true"
                            AllowFiltering="false" AllowColumnResize="true" AllowColumnReorder="true"
                            SelectionMode="DataGridSelectionMode.Single" AllowRowSelectOnRowClick="true" Value="@SelectedItems" Change="SelectionChanged"
                            RowClick="@(args => SelectRow(args.Data))" RowDoubleClick="@(args => SelectRow(args.Data))"
                            Density="Density.Compact" Class="legacy-data-grid runtime-radzen-grid" EmptyText="暂无运行时数据"
                            ShowPagingSummary="true" PagingSummaryFormat="第 {0}–{1} 条，共 {2} 条" FilterText="筛选"
                            FirstPageTitle="首页" FirstPageAriaLabel="转到首页" PrevPageTitle="上一页" PrevPageAriaLabel="转到上一页"
                            NextPageTitle="下一页" NextPageAriaLabel="转到下一页" LastPageTitle="末页" LastPageAriaLabel="转到末页"
                            PageTitleFormat="第 {0} 页" PageAriaLabelFormat="转到第 {0} 页">
                <HeaderTemplate>
                    <div class="radzen-grid-toolbar">
                        <RadzenButton Text="刷新快照" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="Load" />
                        @if (IsAccountCollection && _canManage)
                        {
                            <RadzenButton Text="新建账号" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="CreateAccount" />
                        }
                        <div class="runtime-column-filters">
                            @foreach (RuntimeColumnDefinition column in Definition.Columns)
                            {
                                <label>
                                    <span>@column.Title</span>
                                    @if (IsChoiceColumn(column.Field))
                                    {
                                        <select value="@GetFilter(column.Field)" @onchange="args => SetFilter(column.Field, args.Value?.ToString())">
                                            <option value="">全部</option>
                                            @foreach (string option in DistinctValues(column.Field))
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input value="@GetFilter(column.Field)" placeholder="@column.Title"
                                               @oninput="args => SetFilter(column.Field, args.Value?.ToString())" />
                                    }
                                </label>
                            }
                            @if (HasFilters)
                            {
                                <RadzenButton Text="清除筛选" ButtonStyle="ButtonStyle.Light" Click="ClearFilters" />
                            }
                        </div>
                    </div>
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="RuntimeDataRow" Property="Index" Title="序号" Width="86px" Frozen="true" />
                    @foreach (RuntimeColumnDefinition column in Definition.Columns)
                    {
                        <RadzenDataGridColumn TItem="RuntimeDataRow" Title="@column.Title" Width="180px" Filterable="false" Sortable="false">
                            <Template Context="row">@Format(row, column.Field)</Template>
                        </RadzenDataGridColumn>
                    }
                    <RadzenDataGridColumn TItem="RuntimeDataRow" Title="操作" Width="@(IsAccountCollection ? "150px" : "88px")" Filterable="false" Sortable="false">
                        <Template Context="row">
                            <div class="grid-row-actions">
                                @if (_canManage)
                                {
                                    <RadzenButton Text="编辑" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                                  Click="@(() => SelectRow(row))" />
                                }
                                @if (IsAccountCollection && _canOwner)
                                {
                                    <RadzenButton Text="删除" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger"
                                                  Click="@(() => DeleteAccount(row))" />
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </section>

        <aside class="editor-panel runtime-editor">
            @if (SelectedRow is null)
            {
                <div class="editor-empty">
                    <span>@(_canManage ? "选择一行" : "只读视图")</span>
                    <p>@(_canManage ? "选择一行以查看和编辑允许的字段。" : "当前身份无修改权限；如需修改请用「管理员」身份登录。")</p>
                </div>
            }
            else
            {
                <div class="editor-title"><span>#@SelectedRow.Index</span><strong>@Definition.DisplayName</strong></div>
                <div class="editor-fields">
                    @foreach (RuntimeColumnDefinition column in Definition.Columns)
                    {
                        object? sourceValue = SelectedRow.Values.GetValueOrDefault(column.Field);
                        <label>
                            <span>@column.Title @if (!column.Editable) { <em>只读</em> }</span>
                            @if (sourceValue?.GetType().IsEnum == true)
                            {
                                Type enumType = sourceValue.GetType();
                                <select value="@EditValues.GetValueOrDefault(column.Field)" disabled="@(!column.Editable)"
                                        @onchange="args => EditValues[column.Field] = args.Value?.ToString()">
                                    @foreach (string option in Enum.GetNames(enumType))
                                    {
                                        <option value="@option">@UiText.EnumValue(enumType, option)</option>
                                    }
                                </select>
                            }
                            else if (sourceValue is bool)
                            {
                                <select value="@EditValues.GetValueOrDefault(column.Field)" disabled="@(!column.Editable)"
                                        @onchange="args => EditValues[column.Field] = args.Value?.ToString()">
                                    <option value="True">是</option>
                                    <option value="False">否</option>
                                </select>
                            }
                            else
                            {
                                <input value="@EditValues.GetValueOrDefault(column.Field)" disabled="@(!column.Editable)"
                                       @onchange="args => EditValues[column.Field] = args.Value?.ToString()" />
                            }
                        </label>
                    }
                </div>
                <div class="editor-actions"><RadzenButton Text="保存到 Users.db" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="Save" /></div>
            }
        </aside>
    </div>
}

@code {
    [Parameter, EditorRequired] public string CollectionKey { get; set; } = string.Empty;

    private RuntimeCollectionDescriptor Definition = default!;
    private IReadOnlyList<RuntimeDataRow> Rows = [];
    private IList<RuntimeDataRow> SelectedItems { get; set; } = [];
    private RuntimeDataRow? SelectedRow => SelectedItems.SingleOrDefault();
    private Dictionary<string, string?> EditValues = [];
    private string? Message;
    private bool HasError;

    /// <summary>按钮级权限（二期）：管理员=改数据/新建账号；主密码=删除账号。</summary>
    private bool _canManage;
    private bool _canOwner;

    protected override async Task OnParametersSetAsync()
    {
        Definition = RuntimeDataManager.Get(CollectionKey);

        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canManage = AdminPermissions.CanManage(state.User);
        _canOwner = AdminPermissions.CanOwner(state.User);

        await Load();
    }

    /// <summary>单击 / 双击 / 右键 / 编辑按钮：统一选中该行并打开右侧编辑面板。</summary>
    private void SelectRow(RuntimeDataRow? row)
    {
        if (row is null) return;

        // 二期：没有「管理员」身份时不给打开编辑面板（否则只读身份也能改数据）
        if (!_canManage)
        {
            SelectedItems = [];
            EditValues = [];
            HasError = false;
            Message = "只读视图：修改运行时数据需要「管理员」身份。";
            return;
        }

        SelectedItems = [row];
        EditValues = row.Values.ToDictionary(pair => pair.Key, pair => pair.Value?.ToString());
    }

    private void SelectionChanged(IList<RuntimeDataRow> selected)
    {
        if (!_canManage)
        {
            SelectedItems = [];
            EditValues = [];
            return;
        }

        SelectedItems = selected;
        EditValues = SelectedRow?.Values.ToDictionary(pair => pair.Key, pair => pair.Value?.ToString()) ?? [];
    }

    private async Task Load()
    {
        Rows = GameServer.State == GameServerState.Running ? await RuntimeDataManager.ReadAsync(Definition) : [];
        SelectedItems = [];
        EditValues = [];
    }

    private async Task Save()
    {
        if (SelectedRow is null) return;

        if (!_canManage) { HasError = true; Message = "权限不足：修改运行时数据需要「管理员」身份。"; return; }

        try
        {
            string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
            await RuntimeDataManager.UpdateAsync(Definition, SelectedRow.Index, SelectedRow.ETag, EditValues, user);
            await Load();
            HasError = false;
            Message = "运行时数据已保存。";
        }
        catch (Exception ex)
        {
            HasError = true;
            Message = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private bool IsAccountCollection => string.Equals(Definition.Key, "accounts", StringComparison.OrdinalIgnoreCase);

    /// <summary>新建账号：邮箱 + 密码必填，创建 IP 取操作者浏览器 IP，时间取服务器当前时间。</summary>
    private async Task CreateAccount()
    {
        if (!_canManage) { HasError = true; Message = "权限不足：新建账号需要「管理员」身份。"; return; }

        try
        {
            AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            string user = state.User.Identity?.Name ?? "unknown";
            string clientIp = state.User.FindFirst("client_ip")?.Value ?? "unknown";

            Dictionary<string, object?> parameters = new() { ["ClientIp"] = clientIp };

            object? result = await DialogService.OpenAsync<CreateAccountDialog>("新建账号",
                parameters,
                new DialogOptions { Width = "420px", CloseDialogOnOverlayClick = false });

            if (result is not CreateAccountDialog.CreateAccountRequest request) return;

            await RuntimeDataManager.CreateAccountAsync(request.Email, request.Password, clientIp, user);

            await Load();
            HasError = false;
            Message = $"账号已创建：{request.Email}（已激活，可直接登录；创建 IP {clientIp}）。";
        }
        catch (Exception ex)
        {
            HasError = true;
            Message = ex.InnerException?.Message ?? ex.Message;
        }
    }

    /// <summary>删除账号：先二次确认，再按依赖顺序级联清理（角色、物品、货币、邮件等）。</summary>
    private async Task DeleteAccount(RuntimeDataRow row)
    {
        if (!_canOwner) { HasError = true; Message = "权限不足：删除账号仅限主密码登录的管理员。"; return; }

        string email = row.Values.GetValueOrDefault("EMailAddress")?.ToString() ?? $"#{row.Index}";

        bool? confirmed = await DialogService.Confirm(
            $"将永久删除账号「{email}」及其名下全部角色、物品、货币、邮件等数据，删除后无法恢复。确定继续吗？",
            "删除账号",
            new ConfirmOptions
            {
                OkButtonText = "确认删除",
                CancelButtonText = "取消",
                CloseDialogOnOverlayClick = false,
            });

        if (confirmed != true) return;

        try
        {
            string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

            await RuntimeDataManager.DeleteAccountAsync(row.Index, row.ETag, user);

            await Load();
            HasError = false;
            Message = $"账号已删除：{email}";
        }
        catch (Exception ex)
        {
            HasError = true;
            Message = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private static string Format(RuntimeDataRow row, string field) => UiText.Value(row.Values.GetValueOrDefault(field));

    private readonly Dictionary<string, string?> ColumnFilters = [];

    private bool HasFilters => ColumnFilters.Values.Any(value => !string.IsNullOrWhiteSpace(value));

    private IReadOnlyList<RuntimeDataRow> VisibleRows
    {
        get
        {
            if (!HasFilters) return Rows;

            return Rows.Where(row => ColumnFilters.All(pair =>
            {
                if (string.IsNullOrWhiteSpace(pair.Value)) return true;

                string text = Format(row, pair.Key);

                // 下拉选择的列（角色/账号）走精确匹配，避免选 test 把 test02 也带出来
                return IsChoiceColumn(pair.Key)
                    ? string.Equals(text, pair.Value, StringComparison.OrdinalIgnoreCase)
                    : text.Contains(pair.Value, StringComparison.OrdinalIgnoreCase);
            })).ToList();
        }
    }

    private string? GetFilter(string field) => ColumnFilters.GetValueOrDefault(field);

    private void SetFilter(string field, string? value)
    {
        ColumnFilters[field] = value;
        SelectedItems = [];
        EditValues = [];
    }

    private void ClearFilters()
    {
        ColumnFilters.Clear();
        SelectedItems = [];
        EditValues = [];
    }

    /// <summary>角色 / 账号这类列用下拉选择，避免手输。</summary>
    private static bool IsChoiceColumn(string field) => field is "Character" or "Account" or "Player";

    private IEnumerable<string> DistinctValues(string field) =>
        Rows.Select(row => Format(row, field))
            .Where(value => !string.IsNullOrWhiteSpace(value) && value != "—")
            .Distinct()
            .OrderBy(value => value);
}
