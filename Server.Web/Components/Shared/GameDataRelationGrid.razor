@inject GameDataSessionService DataSession
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService

<section class="relation-grid-shell">
    
    @* 注意：TItem="object" 时不能开 AllowFiltering/AllowSorting——
       Radzen 会用 Expression.PropertyOrField(typeof(object), 字段名) 构建表达式，直接抛
       "'X' is not a member of type 'System.Object'"（表现为点按钮后整页报错）。 *@
    <RadzenDataGrid @key="Relation.Property" @ref="Grid" TItem="object" Data="@Rows" AllowPaging="true" PageSize="15"
                    AllowSorting="false" AllowFiltering="false"
                    AllowColumnResize="true" AllowColumnReorder="true" EditMode="DataGridEditMode.Single"
                    RowCreate="CreateRow" RowUpdate="UpdateRow" RowRender="RenderRow" Density="Density.Compact"
                    Class="legacy-data-grid relation-radzen-grid" EmptyText="暂无关联数据"
                    ShowPagingSummary="true" PagingSummaryFormat="第 {0}–{1} 条，共 {2} 条"
                    FilterText="筛选" ApplyFilterText="应用" ClearFilterText="清除" AndOperatorText="并且" OrOperatorText="或者"
                    EqualsText="等于" NotEqualsText="不等于" LessThanText="小于" LessThanOrEqualsText="小于或等于"
                    GreaterThanText="大于" GreaterThanOrEqualsText="大于或等于" ContainsText="包含"
                    DoesNotContainText="不包含" StartsWithText="开头是" EndsWithText="结尾是"
                    IsNullText="为空" IsNotNullText="不为空" IsEmptyText="空字符串" IsNotEmptyText="非空字符串"
                    FirstPageTitle="首页" FirstPageAriaLabel="转到首页" PrevPageTitle="上一页" PrevPageAriaLabel="转到上一页"
                    NextPageTitle="下一页" NextPageAriaLabel="转到下一页" LastPageTitle="末页" LastPageAriaLabel="转到末页"
                    PageTitleFormat="第 {0} 页" PageAriaLabelFormat="转到第 {0} 页">
        <Template Context="child">
            @if (Relation.Relations.Count > 0 && child is MirDB.DBObject childObject)
            {
                @* 与主表同理：新增未保存的子项不在集合里，再往下查子表会查不到父记录。 *@
                if (!SavedRows.Contains(childObject))
                {
                    <div class="hierarchy-detail-panel nested-hierarchy-detail">
                        <div class="grid-hint">该子项尚未保存，请先保存后再展开下一级。</div>
                    </div>
                }
                else
                {
                    <div class="hierarchy-detail-panel nested-hierarchy-detail">
                        @foreach (GameDataRelationDefinition childRelation in Relation.Relations)
                        {
                            <section class="nested-relation-section">
                                <div class="nested-relation-title">
                                    <RadzenIcon Icon="account_tree" />
                                    <span>@childRelation.Title</span>
                                </div>
                                <GameDataRelationGrid @key="(Relation.Property, childObject.Index, childRelation.Property)"
                                                      ParentType="@Relation.ItemType" ParentIndex="@childObject.Index"
                                                      Relation="@childRelation" />
                            </section>
                        }
                    </div>
                }
            }
        </Template>
        <HeaderTemplate>
            <div class="radzen-grid-toolbar">
                <span class="relation-grid-title">@Relation.Title</span>
                @if (_canManage)
                {
                    <RadzenButton Size="ButtonSize.Small" Text="新增子项" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="AddRow" />
                }
                <RadzenButton Size="ButtonSize.Small" Text="刷新明细" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="Load" />
                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <span class="relation-message @(HasError ? "danger" : null)">@Message</span>
                }
            </div>
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="object" Property="Index" Type="typeof(int)" Title="序号" Width="64px"
                                  Reorderable="false" Filterable="false" Sortable="false" Frozen="true" />
            @foreach (GameDataColumnDefinition column in Relation.Columns)
            {
                Type fieldType = Relation.ItemType.GetProperty(column.Field)?.PropertyType ?? typeof(string);
                bool isReference = typeof(MirDB.DBObject).IsAssignableFrom(fieldType);
                bool isEnum = (Nullable.GetUnderlyingType(fieldType) ?? fieldType).IsEnum;
                @if (isReference)
                {
                    <RadzenDataGridColumn TItem="object" Type="@fieldType" Title="@column.Title" Width="@ColumnWidth(column, fieldType)" Sortable="false"
                                          SortComparer="@GameDataReferenceComparer.Instance" Filterable="false">
                        <Template Context="cell">
                            <span class="grid-cell-text" title="@CellText(cell, column.Field)">@CellText(cell, column.Field)</span>
                        </Template>
                        <EditTemplate Context="editItem">
                            @if (column.Editable && IsEditable(column.Field, fieldType))
                            {
                                <GameDataReferenceEditor Item="@editItem" Field="@column.Field" ReferenceType="@fieldType"
                                                         ParentType="@ParentType" ParentIndex="@ParentIndex" />
                            }
                            else
                            {
                                @FormatReference(editItem, column.Field)
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
                else if (isEnum)
                {
                    Type enumType = Nullable.GetUnderlyingType(fieldType) ?? fieldType;
                    <RadzenDataGridColumn TItem="object" Type="@fieldType" Title="@column.Title" Width="@ColumnWidth(column, fieldType)" Sortable="false"
                                          SortComparer="@GameDataReferenceComparer.Instance" Filterable="false">
                        <Template Context="cell">
                            <span class="grid-cell-text" title="@CellText(cell, column.Field)">@CellText(cell, column.Field)</span>
                        </Template>
                        <EditTemplate Context="editItem">
                            @if (column.Editable && IsEditable(column.Field, fieldType))
                            {
                                <GameDataEnumEditor Item="@editItem" Field="@column.Field" EnumType="@enumType" />
                            }
                            else
                            {
                                @GetDisplayValue(editItem, column.Field)
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
                else
                {
                    <RadzenDataGridColumn TItem="object" Type="@fieldType" Title="@column.Title" Width="@ColumnWidth(column, fieldType)" Sortable="false">
                        <Template Context="cell">
                            <span class="grid-cell-text" title="@CellText(cell, column.Field)">@CellText(cell, column.Field)</span>
                        </Template>
                        <EditTemplate Context="editItem">
                            @if (column.Editable && IsEditable(column.Field, fieldType))
                            {
                                <GameDataValueEditor Item="@editItem" Field="@column.Field" ValueType="@fieldType" />
                            }
                            else
                            {
                                @GetDisplayValue(editItem, column.Field)
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            }
            <RadzenDataGridColumn TItem="object" Title="操作" Width="156px" Filterable="false" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                <Template Context="item">
                    <div class="grid-row-actions">
                        @if (_canManage)
                        {
                            <RadzenButton Icon="edit" title="编辑" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => EditRow(item))" @onclick:stopPropagation="true" />
                            <RadzenButton Icon="delete" title="@(Relation.Aggregate ? "删除" : "解除关联")" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteRow(item))" @onclick:stopPropagation="true" />
                        }
                    </div>
                </Template>
                <EditTemplate Context="item">
                    <div class="grid-row-actions">
                        <RadzenButton Icon="check" title="保存" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@(() => SaveRow(item))" />
                        <RadzenButton Icon="close" title="取消" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => CancelRow(item))" />
                    </div>
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</section>

@code {
    [Parameter, EditorRequired] public Type ParentType { get; set; } = default!;
    [Parameter, EditorRequired] public GameDataRelationDefinition Relation { get; set; } = default!;
    [Parameter, EditorRequired] public int ParentIndex { get; set; }

    private IReadOnlyList<object> Rows = [];

    /// <summary>已落库的子项（引用比较），只有它们能继续往下展开；新增未保存的不能。</summary>
    private HashSet<object> SavedRows = new(ReferenceEqualityComparer.Instance);
    private RadzenDataGrid<object>? Grid;
    private string? Message;
    private bool HasError;

    /// <summary>按钮级权限（二期）：子项的新增/编辑/删除同样需要「管理员」身份。</summary>
    private bool _canManage;

    protected override async Task OnParametersSetAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canManage = AdminPermissions.CanManage(state.User);

        await Load();
    }
    private void RenderRow(RowRenderEventArgs<object> args) => args.Expandable = Relation.Relations.Count > 0;
    private Task AddRow() => Grid?.InsertRow(Activator.CreateInstance(Relation.ItemType)!) ?? Task.CompletedTask;
    private Task EditRow(object item) => Grid?.EditRow(item) ?? Task.CompletedTask;
    private Task SaveRow(object item) => Grid?.UpdateRow(item) ?? Task.CompletedTask;
    private void CancelRow(object item) => Grid?.CancelEditRow(item);

    private async Task CreateRow(object item) => await Run(async user =>
    {
        if (!_canManage) DenyManage();
        await DataSession.CreateRelationAsync(ParentType, ParentIndex, Relation, (MirDB.DBObject)item, user);
        await Load();
        Message = "子项已新增并保存。";
    });

    private async Task UpdateRow(object item) => await Run(async user =>
    {
        if (!_canManage) DenyManage();
        await DataSession.UpdateRelationAsync(ParentType, ParentIndex, Relation, (MirDB.DBObject)item, user);
        await Load();
        Message = "子项修改已保存。";
    });

    private async Task DeleteRow(object item)
    {
        if (!RequireManage()) return;

        string action = Relation.Aggregate ? "删除子项" : "解除关联";
        bool? confirmed = await DialogService.Confirm($"确定要{action}吗？", action,
            new ConfirmOptions { OkButtonText = "确定", CancelButtonText = "取消" });
        if (confirmed != true) return;
        await Run(async user =>
        {
            await DataSession.DeleteRelationAsync(ParentType, ParentIndex, Relation, ((MirDB.DBObject)item).Index, user);
            await Load();
            Message = Relation.Aggregate ? "子项已删除。" : "关联已解除。";
        });
    }

    /// <summary>
    /// 按钮级权限守卫（服务端执行）。
    /// **不能抛异常**：事件处理器里未捕获异常会中断 Blazor 电路，页面变「点了没反应」。
    /// </summary>
    private bool RequireManage()
    {
        if (_canManage) return true;

        HasError = true;
        Message = "权限不足：修改关联数据需要「管理员」身份。";
        return false;
    }

    /// <summary>供 Run(...) 内部使用：抛出的异常由 Run 捕获并转成提示，不会中断 Blazor 电路。</summary>
    private void DenyManage() => throw new InvalidOperationException("权限不足：修改关联数据需要「管理员」身份。");

    private async Task Load() => Rows = await LoadRowsAsync();

    private async Task<IReadOnlyList<object>> LoadRowsAsync()
    {
        IReadOnlyList<object> rows = await DataSession.ReadRelationAsync(ParentType, ParentIndex, Relation);
        SavedRows = new HashSet<object>(rows, ReferenceEqualityComparer.Instance);
        return rows;
    }

    private async Task Run(Func<string, Task> operation)
    {
        try
        {
            string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
            await operation(user);
            HasError = false;
        }
        catch (Exception ex)
        {
            HasError = true;
            Message = ex.InnerException?.Message ?? ex.Message;
            await Load();
        }
    }

    private bool IsEditable(string field, Type type) => Relation.ItemType.GetProperty(field)?.SetMethod?.IsPublic == true &&
        (typeof(MirDB.DBObject).IsAssignableFrom(type) || IsSimple(type));
    private static bool IsSimple(Type type)
    {
        Type actual = Nullable.GetUnderlyingType(type) ?? type;
        return actual.IsPrimitive || actual.IsEnum || actual == typeof(string) || actual == typeof(decimal) || actual == typeof(DateTime) || actual == typeof(TimeSpan);
    }
    private static string FormatReference(object item, string field)
    {
        MirDB.DBObject? value = item.GetType().GetProperty(field)?.GetValue(item) as MirDB.DBObject;
        return value is null ? "—" : UiText.Reference(value);
    }
    private static string GetDisplayValue(object item, string field) => UiText.Value(item.GetType().GetProperty(field)?.GetValue(item));

    /// <summary>列宽：取「类型最小宽度」与「表头文字所需宽度」的较大值，避免中文列名被省略号截断。</summary>
    private static string ColumnWidth(GameDataColumnDefinition column, Type type)
    {
        if (!string.IsNullOrWhiteSpace(column.Width)) return column.Width;

        Type underlying = Nullable.GetUnderlyingType(type) ?? type;

        int minimum =
            typeof(MirDB.DBObject).IsAssignableFrom(underlying) ? 200 :
            underlying == typeof(bool) ? 96 :
            underlying.IsEnum ? 130 : 120;

        int width = Math.Max(minimum, TextWidth(column.Title) + 40);

        return $"{Math.Min(width, 280)}px";
    }

    private static int TextWidth(string? text)
    {
        if (string.IsNullOrEmpty(text)) return 0;

        int width = 0;
        foreach (char character in text)
        {
            width += character >= 0x2E80 ? 15 : 9;
        }
        return width;
    }

    private static string CellText(object item, string field)
    {
        object? value = item.GetType().GetProperty(field)?.GetValue(item);

        return value is MirDB.DBObject reference ? UiText.Reference(reference) : UiText.Value(value);
    }
}
