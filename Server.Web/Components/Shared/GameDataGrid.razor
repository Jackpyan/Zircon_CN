@attribute [Authorize]
@implements IAsyncDisposable
@inject GameDataSessionService DataSession
@inject GameDataViewCatalog ViewCatalog
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IGameServerController GameServer
@inject IJSRuntime JS
@inject DialogService DialogService
@inject RuntimeDataService RuntimeData

<PageTitle>@View.Title · Zircon</PageTitle>

<div class="page-heading compact game-data-heading">
    <div>
        <span class="eyebrow">游戏数据 / @View.Category</span>
        <h1>@View.Title</h1>
        <p>@View.Description</p>
    </div>
    <div class="view-origin"><span>原管理界面</span><strong>@LegacyViewName</strong></div>
</div>

@if (View.Tables.Count > 1)
{
    <div class="entity-switcher view-tabs" role="tablist" aria-label="数据类型">
        @foreach (GameDataTableDefinition candidate in View.Tables)
        {
            <button class="@(candidate == Table ? "active" : null)" role="tab" aria-selected="@(candidate == Table)"
                    @onclick="() => SelectTable(candidate)">@candidate.Title</button>
        }
    </div>
}

<section class="legacy-grid-shell">
    <div class="game-data-bar">
        @* 工具条放在网格外面：表格横向 / 纵向滚动时按钮不会被卷走，筛选面板也不受表格宽度限制 *@
        <div class="radzen-grid-toolbar game-data-toolbar">
            <div class="grid-toolbar-actions">
                @if (_canManage)
                {
                    <RadzenButton Size="ButtonSize.Small" Text="新增" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="AddRow"/>
                }
                <RadzenButton Size="ButtonSize.Small" Text="刷新" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="Reload"/>
                @if (_canManage)
                {
                    <RadzenButton Size="ButtonSize.Small" Text="保存数据库" Icon="save" ButtonStyle="ButtonStyle.Light" Click="SaveDatabase"/>
                    <RadzenButton Size="ButtonSize.Small" Text="在选中行后插入" Icon="playlist_add" ButtonStyle="ButtonStyle.Light" Click="InsertAfter"
                                  Disabled="@(SelectedItems.Count != 1 || GameServer.State != GameServerState.Stopped)"/>
                }
                <RadzenButton Size="ButtonSize.Small" Text="导出选中" Icon="download" ButtonStyle="ButtonStyle.Light" Click="ExportSelected" Disabled="@(SelectedItems.Count == 0)"/>
                <RadzenButton Size="ButtonSize.Small" Text="导出全部" Icon="file_download" ButtonStyle="ButtonStyle.Light" Click="ExportAll"/>
                <label class="file-action radzen-file-action">
                    <RadzenIcon Icon="upload_file"/>
                    导入 JSON
                    <InputFile OnChange="Import" accept="application/json,.json"/>
                </label>
            </div>
            <div class="grid-toolbar-search">
                <input class="grid-search" type="search" placeholder="搜索全部列…"
                       aria-label="搜索全部列" value="@QuickSearch"
                       @oninput="args => SetQuickSearch(args.Value?.ToString())"/>
                <RadzenButton Size="ButtonSize.Small" ButtonStyle="@(ShowFilters ? ButtonStyle.Primary : ButtonStyle.Light)"
                              Icon="filter_alt" Text="@FilterButtonText" Click="ToggleFilters"/>
                @if (HasFilters)
                {
                    <RadzenButton Size="ButtonSize.Small" Text="清除筛选" Icon="filter_alt_off" ButtonStyle="ButtonStyle.Light" Click="ClearFilters"/>
                    <span class="grid-filter-count">筛出 @VisibleRows.Count / @Rows.Count</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <span class="alert @(HasError ? "danger" : "success")" role="status">@Message</span>
            }
        </div>
        @if (ShowFilters)
        {
            <div class="grid-filter-panel">
                @foreach (GameDataColumnDefinition column in Table.Columns)
                {
                    <label class="grid-filter-field">
                        <span>@column.Title</span>
                        @if (IsChoiceColumn(column.Field))
                        {
                            <select value="@GetFilter(column.Field)" aria-label="@($"{column.Title} 筛选")"
                                    @onchange="args => SetFilter(column.Field, args.Value?.ToString())">
                                <option value="">全部</option>
                                @foreach (string option in DistinctChoices(column.Field))
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input value="@GetFilter(column.Field)" placeholder="@column.Title"
                                   aria-label="@($"{column.Title} 筛选")"
                                   @oninput="args => SetFilter(column.Field, args.Value?.ToString())"/>
                        }
                    </label>
                }
            </div>
        }
    </div>


    <RadzenDataGrid @key="Table.Key" @ref="Grid" TItem="object" Data="@VisibleRows" AllowPaging="true" PageSize="30"
                    AllowSorting="true" AllowFiltering="false"
                    AllowColumnResize="true" AllowColumnReorder="true"
                    EditMode="DataGridEditMode.Single" RowCreate="CreateRow" RowUpdate="UpdateRow"
                    RowRender="RenderRow"
                    Density="Density.Compact" Class="game-data-grid" EmptyText="暂无数据" SelectionMode="DataGridSelectionMode.Multiple"
                    ShowPagingSummary="true" PagingSummaryFormat="第 {0}–{1} 条，共 {2} 条"
                    FirstPageTitle="首页" FirstPageAriaLabel="转到首页" PrevPageTitle="上一页" PrevPageAriaLabel="转到上一页"
                    NextPageTitle="下一页" NextPageAriaLabel="转到下一页" LastPageTitle="末页" LastPageAriaLabel="转到末页"
                    PageTitleFormat="第 {0} 页" PageAriaLabelFormat="转到第 {0} 页"
                    PagerHorizontalAlign="HorizontalAlign.Left" PagerInputSize="InputSize.Small">
        <Template Context="parent">
            @if (Table.Relations.Count > 0 && parent is MirDB.DBObject parentObject)
            {
                GameDataRelationDefinition selectedRelation = GetSelectedRelation(parentObject.Index);
                <div class="hierarchy-detail-panel">
                    @if (Table.Relations.Count > 1)
                    {
                        <div class="entity-switcher hierarchy-relation-tabs" role="tablist" aria-label="@($"{parentObject} 的关联数据")">
                            @foreach (GameDataRelationDefinition candidate in Table.Relations)
                            {
                                <button class="@(candidate == selectedRelation ? "active" : null)" role="tab"
                                        aria-selected="@(candidate == selectedRelation)"
                                        @onclick="() => SelectRelation(parentObject.Index, candidate)"
                                        @onclick:stopPropagation="true">@candidate.Title</button>
                            }
                        </div>
                    }
                    <GameDataRelationGrid @key="(Table.Key, parentObject.Index, selectedRelation.Property)"
                                          ParentType="@Table.ModelType" ParentIndex="@parentObject.Index"
                                          Relation="@selectedRelation" />
                </div>
            }
        </Template>
        <Columns>
            <RadzenDataGridColumn TItem="object" Width="40px" Reorderable="false" Filterable="false" Sortable="false" Frozen="true">
                <HeaderTemplate>
                    <RadzenCheckBox TabIndex="-1" TriState="false" TValue="bool?" InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "选择全部记录" }})"
                                    Value="@(SelectedItems.Any() != true ? false : !VisibleRows.All(i => SelectedItems.Contains(i)) ? null : VisibleRows.Any(i => SelectedItems.Contains(i)))"
                                    Change="@(args => SelectedItems = args == true ? VisibleRows.ToList() : [])" />
                </HeaderTemplate>
                <Template Context="item">
                    <RadzenCheckBox TValue="bool" Value="@SelectedItems.Contains(item)" Change="@(_ => ToggleSelection(item))"
                                    Class="grid-selection-checkbox" @onclick:stopPropagation="true"/>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="object" Property="Index" Type="typeof(int)" Title="序号" Width="64px" Reorderable="false" Filterable="false" Sortable="false" Frozen="true"/>
            @foreach (GameDataColumnDefinition column in Table.Columns)
            {
                Type fieldType = GetFieldType(column.Field);
                bool isReference = typeof(MirDB.DBObject).IsAssignableFrom(fieldType);
                bool isEnum = (Nullable.GetUnderlyingType(fieldType) ?? fieldType).IsEnum;
                @if (isReference)
                {
                    <RadzenDataGridColumn TItem="object" Property="@column.Field" Type="@fieldType" Title="@column.Title" Width="@ColumnWidth(column, fieldType)"
                                          SortComparer="@GameDataReferenceComparer.Instance" Filterable="false">
                        <Template Context="cell">
                            <span class="grid-cell-text" title="@CellText(cell, column.Field)">@CellText(cell, column.Field)</span>
                        </Template>
                        <EditTemplate Context="editItem">
                            @if (column.Editable && IsEditable(column.Field, fieldType))
                            {
                                <GameDataReferenceEditor Item="@editItem" Field="@column.Field" ReferenceType="@fieldType"/>
                            }
                            else
                            {
                                @FormatReference(editItem, column.Field)
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
                else if (isEnum)
                {
                    Type enumType = Nullable.GetUnderlyingType(fieldType) ?? fieldType;
                    <RadzenDataGridColumn TItem="object" Property="@column.Field" Type="@fieldType" Title="@column.Title" Width="@ColumnWidth(column, fieldType)"
                                          SortComparer="@GameDataReferenceComparer.Instance" Filterable="false">
                        <Template Context="cell">
                            <span class="grid-cell-text" title="@CellText(cell, column.Field)">@CellText(cell, column.Field)</span>
                        </Template>
                        <EditTemplate Context="editItem">
                            @if (column.Editable && IsEditable(column.Field, fieldType))
                            {
                                <GameDataEnumEditor Item="@editItem" Field="@column.Field" EnumType="@enumType"/>
                            }
                            else
                            {
                                @GetDisplayValue(editItem, column.Field)
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
                else
                {
                    <RadzenDataGridColumn TItem="object" Property="@column.Field" Type="@fieldType" Title="@column.Title" Width="@ColumnWidth(column, fieldType)"
                                          Filterable="false">
                        <Template Context="cell">
                            <span class="grid-cell-text" title="@CellText(cell, column.Field)">@CellText(cell, column.Field)</span>
                        </Template>
                        <EditTemplate Context="editItem">
                            @if (column.Editable && IsEditable(column.Field, fieldType))
                            {
                                <GameDataValueEditor Item="@editItem" Field="@column.Field" ValueType="@fieldType"/>
                            }
                            else
                            {
                                @GetDisplayValue(editItem, column.Field)
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            }
            <RadzenDataGridColumn TItem="object" Title="操作" Width="@(SupportsGiveItem ? "126px" : "90px")" Filterable="false" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                <Template Context="item">
                    <div class="grid-row-actions">
                        @if (_canManage)
                        {
                            <RadzenButton Icon="edit" title="编辑" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => EditRow(item))" @onclick:stopPropagation="true"/>
                        }
                        @if (SupportsGiveItem)
                        {
                            @if (_canOperate)
                            {
                                <RadzenButton Icon="card_giftcard" title="发放给角色" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@(() => GiveItem(item))" @onclick:stopPropagation="true"/>
                            }
                        }
                        @if (_canManage)
                        {
                            <RadzenButton Icon="delete" title="删除" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteRow(item))" @onclick:stopPropagation="true"/>
                        }
                    </div>
                </Template>
                <EditTemplate Context="item">
                    <div class="grid-row-actions">
                        <RadzenButton Icon="check" title="保存" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@(() => SaveRow(item))"/>
                        <RadzenButton Icon="close" title="取消" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => CancelRow(item))"/>
                    </div>
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</section>

@code {
    [Parameter, EditorRequired] public string ViewKey { get; set; } = string.Empty;

    private GameDataViewDefinition View = default!;
    private GameDataTableDefinition Table = default!;
    private IReadOnlyList<object> Rows = [];
    private IList<object> SelectedItems { get; set; } = [];
    private RadzenDataGrid<object>? Grid;
    private readonly Dictionary<int, string> SelectedRelations = [];
    private string? Message;
    private bool HasError;

    /// <summary>按钮级权限（二期）：运营者=发放物品；管理员=改数据/新增/删除/存库。</summary>
    private bool _canOperate;
    private bool _canManage;
    private IJSObjectReference? DownloadModule;
    private string LegacyViewName => View.Title;

    // ── 筛选（自己实现，不用 Radzen 自带筛选）─────────────────────────────
    // 原因：TItem 是 object，Radzen 内置筛选（高级模式）按字段名 + 原始值比较，
    // 引用列 / 枚举列只能关掉筛选，剩下能筛的列还得手输数字（枚举要输整数、布尔要输 True），
    // 基本没法用。这里改成按「显示文本」筛选，与界面上看到的完全一致。
    private string QuickSearch = string.Empty;
    private bool ShowFilters;
    private readonly Dictionary<string, string?> ColumnFilters = [];

    /// <summary>每行各列的显示文本缓存（按对象引用），避免每次按键都反射取一遍 20 多列。</summary>
    private readonly Dictionary<object, string[]> RowTextCache = [];
    private readonly Dictionary<string, string[]> ChoiceCache = [];

    private bool HasColumnFilters => ColumnFilters.Values.Any(value => !string.IsNullOrWhiteSpace(value));
    private bool HasFilters => HasColumnFilters || !string.IsNullOrWhiteSpace(QuickSearch);

    private string FilterButtonText => ShowFilters ? "收起筛选" : "列筛选";

    private IReadOnlyList<object>? _visibleRowsCache;

    /// <summary>筛选结果按渲染周期缓存一次，避免一次渲染里被多次求值（大表 1 万行时很关键）。</summary>
    private IReadOnlyList<object> VisibleRows => _visibleRowsCache ??= BuildVisibleRows();

    private IReadOnlyList<object> BuildVisibleRows()
    {
        if (!HasFilters) return Rows;

        List<object> result = new(Rows.Count);
        foreach (object row in Rows)
        {
            if (RowMatches(row)) result.Add(row);
        }
        return result;
    }

    /// <summary>任何影响筛选结果的动作后都要调用，下一帧重新算。</summary>
    private void InvalidateFilters() => _visibleRowsCache = null;

    private bool RowMatches(object row)
    {
        string[] texts = GetRowTexts(row);

        for (int index = 0; index < texts.Length; index++)
        {
            GameDataColumnDefinition column = Table.Columns[index];
            if (!ColumnFilters.TryGetValue(column.Field, out string? filter) || string.IsNullOrWhiteSpace(filter)) continue;

            bool matched = IsChoiceColumn(column.Field)
                ? string.Equals(texts[index], filter, StringComparison.OrdinalIgnoreCase)
                : texts[index].Contains(filter, StringComparison.OrdinalIgnoreCase);

            if (!matched) return false;
        }

        if (string.IsNullOrWhiteSpace(QuickSearch)) return true;

        foreach (string text in texts)
        {
            if (text.Contains(QuickSearch, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    private string[] GetRowTexts(object row)
    {
        if (RowTextCache.TryGetValue(row, out string[]? cached)) return cached;

        string[] texts = new string[Table.Columns.Count];
        for (int index = 0; index < texts.Length; index++)
        {
            texts[index] = CellText(row, Table.Columns[index].Field);
        }

        RowTextCache[row] = texts;
        return texts;
    }

    /// <summary>布尔与枚举列用下拉框（值域固定），其余列用文本包含。</summary>
    private bool IsChoiceColumn(string field)
    {
        Type type = Nullable.GetUnderlyingType(GetFieldType(field)) ?? GetFieldType(field);
        return type == typeof(bool) || type.IsEnum;
    }

    private string? GetFilter(string field) => ColumnFilters.GetValueOrDefault(field);

    private void SetFilter(string field, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) ColumnFilters.Remove(field);
        else ColumnFilters[field] = value;

        InvalidateFilters();
        SelectedItems = [];
        SelectedRelations.Clear();
    }

    private void SetQuickSearch(string? value)
    {
        QuickSearch = value ?? string.Empty;
        InvalidateFilters();
        SelectedItems = [];
        SelectedRelations.Clear();
    }

    private void ToggleFilters() => ShowFilters = !ShowFilters;

    private void ClearFilters()
    {
        ColumnFilters.Clear();
        QuickSearch = string.Empty;
        InvalidateFilters();
        SelectedItems = [];
        SelectedRelations.Clear();
    }

    private IReadOnlyList<string> DistinctChoices(string field)
    {
        if (ChoiceCache.TryGetValue(field, out string[]? cached)) return cached;

        string[] values = Rows.Select(row => CellText(row, field))
            .Where(value => !string.IsNullOrWhiteSpace(value) && value != "—")
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value, StringComparer.CurrentCulture)
            .ToArray();

        ChoiceCache[field] = values;
        return values;
    }

    protected override async Task OnParametersSetAsync()
    {
        View = ViewCatalog.Get(ViewKey);
        Table = View.Tables[0];

        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canOperate = AdminPermissions.CanOperate(state.User);
        _canManage = AdminPermissions.CanManage(state.User);

        await LoadRows();
    }

    /// <summary>
    /// 按钮级权限守卫（服务端执行，防止绕过 UI 直接触发）。
    /// 注意：**不能抛异常**——事件处理器里未捕获的异常会让 Blazor 电路中断，
    /// 表现为「点一次之后整页无响应，必须重新打开页面」。
    /// </summary>
    private bool RequireManage()
    {
        if (_canManage) return true;

        HasError = true;
        Message = "权限不足：该操作需要「管理员」身份。";
        return false;
    }

    private bool RequireOperate()
    {
        if (_canOperate) return true;

        HasError = true;
        Message = "权限不足：该操作需要「运营者」身份。";
        return false;
    }

    /// <summary>供 Run(...) 内部使用：抛出的异常由 Run 捕获并转成提示，不会中断 Blazor 电路。</summary>
    private void DenyManage() => throw new InvalidOperationException("权限不足：该操作需要「管理员」身份。");

    private async Task SelectTable(GameDataTableDefinition table)
    {
        Table = table;
        SelectedItems = [];
        ColumnFilters.Clear();
        QuickSearch = string.Empty;
        _visibleRowsCache = null;
        await LoadRows();
    }

    private void RenderRow(RowRenderEventArgs<object> args) => args.Expandable = Table.Relations.Count > 0;

    private GameDataRelationDefinition GetSelectedRelation(int parentIndex)
    {
        if (SelectedRelations.TryGetValue(parentIndex, out string? property))
            return Table.Relations.FirstOrDefault(item => item.Property == property) ?? Table.Relations[0];
        return Table.Relations[0];
    }

    private void SelectRelation(int parentIndex, GameDataRelationDefinition relation) =>
        SelectedRelations[parentIndex] = relation.Property;

    private bool SupportsGiveItem => Table.ModelType == typeof(Library.SystemModels.ItemInfo);

    private async Task GiveItem(object item)
    {
        if (item is not Library.SystemModels.ItemInfo info) return;

        // Radzen 的 OpenAsync 形参是 Dictionary<string, object?>（值可空），
        // 类型必须完全一致，否则触发 CS8620 可空性警告。
        Dictionary<string, object?> parameters = new() { ["ItemName"] = $"{info.ItemName}（#{info.Index}）" };

        object? result = await DialogService.OpenAsync<GiveItemDialog>($"发放物品 - {info.ItemName}",
            parameters,
            new DialogOptions { Width = "360px", CloseDialogOnOverlayClick = false });

        if (result is not GiveItemDialog.GiveItemRequest request) return;

        try
        {
            if (!RequireOperate()) return;

            string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

            await RuntimeData.GiveItemAsync(info.Index, request.CharacterName, request.Count, user);

            HasError = false;
            Message = $"已向 {request.CharacterName} 发放 {info.ItemName} x{request.Count}。";
        }
        catch (Exception ex)
        {
            HasError = true;
            Message = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private Task AddRow() => Grid?.InsertRow(Activator.CreateInstance(Table.ModelType)!) ?? Task.CompletedTask;
    private Task EditRow(object item) => Grid?.EditRow(item) ?? Task.CompletedTask;
    private Task SaveRow(object item) => Grid?.UpdateRow(item) ?? Task.CompletedTask;
    private void CancelRow(object item) => Grid?.CancelEditRow(item);

    private void ToggleSelection(object item)
    {
        List<object> selected = SelectedItems.ToList();
        if (!selected.Remove(item)) selected.Add(item);
        SelectedItems = selected;
    }

    private async Task CreateRow(object item) => await Run(async user =>
    {
        if (!_canManage) DenyManage();
        await DataSession.CreateAsync(Table, (MirDB.DBObject)item, user);
        await LoadRows();
        Message = "已新增并保存记录。";
    });

    private async Task UpdateRow(object item) => await Run(async user =>
    {
        if (!_canManage) DenyManage();
        await DataSession.UpdateAsync(Table, (MirDB.DBObject)item, user);
        await LoadRows();
        Message = "修改已保存。";
    });

    private async Task DeleteRow(object item)
    {
        if (!RequireManage()) return;

        bool? confirmed = await DialogService.Confirm("删除后将立即保存数据库，确定继续吗？", "删除记录",
            new ConfirmOptions { OkButtonText = "删除", CancelButtonText = "取消" });
        if (confirmed != true) return;
        await Run(async user =>
        {
            await DataSession.DeleteAsync(Table, ((MirDB.DBObject)item).Index, user);
            await LoadRows();
            Message = "记录已删除。";
        });
    }

    private async Task Reload()
    {
        await DataSession.ReloadAsync();
        await LoadRows();
        HasError = false;
        Message = "已重新加载。";
    }

    private async Task SaveDatabase() => await Run(async _ =>
    {
        if (!_canManage) DenyManage();
        await DataSession.SaveAndGetPathAsync();
        Message = "数据库已保存。";
    });

    private async Task InsertAfter()
    {
        if (!RequireManage()) return;
        MirDB.DBObject? selected = SelectedItems.OfType<MirDB.DBObject>().SingleOrDefault();
        if (selected is null) return;
        await Run(async user =>
        {
            await DataSession.InsertAfterAsync(Table, selected.Index, user);
            await LoadRows();
            Message = $"已在 #{selected.Index} 后插入记录。";
        });
    }

    private Task ExportSelected() => Export(SelectedItems.OfType<MirDB.DBObject>().Select(item => item.Index).ToArray());

    /// <summary>导出全部：有筛选时导出筛选结果（所见即所得），避免把看不见的行一起导出去。</summary>
    private Task ExportAll() =>
        Export(HasFilters ? VisibleRows.OfType<MirDB.DBObject>().Select(item => item.Index).ToArray() : null);

    private async Task Export(IReadOnlyCollection<int>? indices)
    {
        await Run(async _ =>
        {
            string json = await DataSession.ExportJsonAsync(Table, indices);
            DownloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/downloads.js");
            int count = indices?.Count ?? Rows.Count;
            string fileName = $"{Table.ModelType.Name} - {count} - {DateTime.UtcNow:yyyy-MM-dd HH-mm-ss}.json";
            await DownloadModule.InvokeVoidAsync("downloadText", fileName, json);
            Message = HasFilters ? $"已导出筛选结果 {count} 行。" : $"已导出 {count} 行数据。";
        });
    }

    private async Task Import(InputFileChangeEventArgs args)
    {
        await Run(async user =>
        {
            await using Stream stream = args.File.OpenReadStream(32 * 1024 * 1024);
            using StreamReader reader = new(stream);
            string json = await reader.ReadToEndAsync();
            (int imported, int resolved) = await DataSession.ImportJsonAsync(Table, json, user);
            await LoadRows();
            Message = $"已导入 {imported} 行，并解析 {resolved} 个引用。";
        });
    }

    private async Task LoadRows()
    {
        Rows = await DataSession.ReadAsync(Table);
        SelectedItems = [];
        SelectedRelations.Clear();
        RowTextCache.Clear();
        ChoiceCache.Clear();
        _visibleRowsCache = null;
    }

    private async Task Run(Func<string, Task> operation)
    {
        try
        {
            string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
            await operation(user);
            HasError = false;
        }
        catch (Exception ex)
        {
            HasError = true;
            Message = ex.InnerException?.Message ?? ex.Message;
            await LoadRows();
        }
    }

    private Type GetFieldType(string field) => Table.ModelType.GetProperty(field)?.PropertyType ?? typeof(string);

    private bool IsEditable(string field, Type type) => Table.ModelType.GetProperty(field)?.SetMethod?.IsPublic == true &&
                                                        (typeof(MirDB.DBObject).IsAssignableFrom(type) || IsSimple(type));

    private static bool IsSimple(Type type)
    {
        Type actual = Nullable.GetUnderlyingType(type) ?? type;
        return actual.IsPrimitive || actual.IsEnum || actual == typeof(string) || actual == typeof(decimal) || actual == typeof(DateTime) || actual == typeof(TimeSpan);
    }

    /// <summary>
    /// 列宽：配置里显式指定优先；否则取「类型最小宽度」与「表头文字所需宽度」的较大值。
    /// 只用类型定宽会让「允许随机传送」「在副本查找器中显示」这类 6~9 个汉字的标题被省略号截断，
    /// 所以必须把表头也算进去（Radzen 表头：左右各 8px 内边距 + 20px 排序图标，中文约 14px/字）。
    /// 总宽超出容器时由底部横向滚动条拖动查看。
    /// </summary>
    private static string ColumnWidth(GameDataColumnDefinition column, Type type)
    {
        if (!string.IsNullOrWhiteSpace(column.Width)) return column.Width;

        Type underlying = Nullable.GetUnderlyingType(type) ?? type;

        int minimum =
            typeof(MirDB.DBObject).IsAssignableFrom(underlying) ? 200 :
            underlying == typeof(string) ? 180 :
            underlying == typeof(bool) ? 96 :
            underlying.IsEnum ? 130 : 96;

        int header = TextWidth(column.Title) + 40;
        int width = Math.Max(minimum, header);

        return $"{Math.Min(width, 280)}px";
    }

    /// <summary>粗略估算文字像素宽：中日韩字符按 14px，其余按 8px（表头字号 0.875rem）。</summary>
    private static int TextWidth(string? text)
    {
        if (string.IsNullOrEmpty(text)) return 0;

        int width = 0;
        foreach (char character in text)
        {
            width += character >= 0x2E80 ? 15 : 9;
        }
        return width;
    }

    /// <summary>单元格显示文本（引用列带序号，枚举/布尔走中文），筛选与渲染共用同一份结果。</summary>
    private static string CellText(object item, string field)
    {
        object? value = item.GetType().GetProperty(field)?.GetValue(item);

        return value is MirDB.DBObject reference ? $"{reference.Index}: {reference}" : UiText.Value(value);
    }

    private static string FormatReference(object item, string field)
    {
        MirDB.DBObject? value = item.GetType().GetProperty(field)?.GetValue(item) as MirDB.DBObject;
        return value is null ? "—" : $"{value.Index}: {value}";
    }

    private static string GetDisplayValue(object item, string field) => UiText.Value(item.GetType().GetProperty(field)?.GetValue(item));

    public async ValueTask DisposeAsync()
    {
        if (DownloadModule is not null) await DownloadModule.DisposeAsync();
    }

}
