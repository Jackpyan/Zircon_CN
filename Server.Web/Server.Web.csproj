<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Server.Web</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" Version="11.2.8" />
    <!-- TOTP 绑定页本地生成二维码（纯托管 SVG 输出，无 System.Drawing 依赖） -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LibraryCore\LibraryCore.csproj" />
    <ProjectReference Include="..\ServerLibrary\ServerLibrary.csproj" />
    <ProjectReference Include="..\Plugin.Abstractions\Plugin.Abstractions.csproj" />
  </ItemGroup>

  <!--
    静态文件：把 wwwroot 一并复制到输出目录。
    Sdk.Web 默认只在 *发布* 时把 wwwroot 放进输出目录，dotnet build 的产物里没有 →
    Production 环境下 WebRootFileProvider 为空 → /css/app.css 返回 200 + 0 字节，后台页面变成纯文字。
    PreserveNewest：只覆盖比输出新的文件，不会在每次构建时重刷一遍大文件。
  -->
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    假人数据文件模板：首次构建/发布时复制到输出目录的 Bots/ 下。
    PreserveNewest = 运营改过的名单不会被下一次构建冲掉；删掉输出目录里的文件会从模板恢复。
  -->
  <ItemGroup>
    <None Update="Bots\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    客户端版本文件（Zircon.dll）：服务端用它算 SHA256 做版本校验（Config.VersionPath 默认 .\Zircon.dll），
    缺失时 Config.ClientHash = null → Functions.IsMatch 恒 false → **任何客户端都会被踢 WrongVersion**。

    ★ 这两条只「引用」，不往服务端产物里拷 ★
    Zircon.dll 由客户端项目（Client.csproj）自己输出，目标就是下面这两条相对路径所指的客户端目录
    （`..\..\Debug\Client\`；Release 配置目前也配到同一处）—— 那是唯一权威副本，
    只有客户端源码变化才会重新生成它，服务端构建永远不该碰它。
    所以这里 CopyToOutputDirectory / CopyToPublishDirectory 都是 Never：
    build / publish 不会往 Debug\Server.Web、Debug\Server.Web_linux-x64、Release\Server.Web 再放一份。
    以前是 PreserveNewest，结果四处各躺一份、时间戳还不同步（publish 那份常是几天前的），
    运维分不清哪份最新，客户端版本校验就会莫名其妙失败。
    本地测试 / 上线部署：手工把 `Debug\Client\Zircon.dll` 拷到服务端目录。
    漏拷的后果是「所有客户端连不上」，不是静默降级，很好发现。
  -->
  <ItemGroup Condition="Exists('..\..\Debug\Client\Zircon.dll')">
    <None Include="..\..\Debug\Client\Zircon.dll" Link="Zircon.dll">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\Release\Client\Zircon.dll')">
    <None Include="..\..\Release\Client\Zircon.dll" Link="Zircon.dll">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>..\..\Debug\Server.Web\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;CA1416</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>..\..\Release\Server.Web\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;CA1416</NoWarn>
  </PropertyGroup>
</Project>
