<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Server.Web</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" Version="11.2.8" />
    <!-- TOTP 绑定页本地生成二维码（纯托管 SVG 输出，无 System.Drawing 依赖） -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LibraryCore\LibraryCore.csproj" />
    <ProjectReference Include="..\ServerLibrary\ServerLibrary.csproj" />
    <ProjectReference Include="..\Plugin.Abstractions\Plugin.Abstractions.csproj" />
  </ItemGroup>

  <!--
    静态文件：把 wwwroot 一并复制到输出目录。
    Sdk.Web 默认只在 *发布* 时把 wwwroot 放进输出目录，dotnet build 的产物里没有 →
    Production 环境下 WebRootFileProvider 为空 → /css/app.css 返回 200 + 0 字节，后台页面变成纯文字。
    PreserveNewest：只覆盖比输出新的文件，不会在每次构建时重刷一遍大文件。
  -->
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    假人数据文件模板：首次构建/发布时复制到输出目录的 Bots/ 下。
    PreserveNewest = 运营改过的名单不会被下一次构建冲掉；删掉输出目录里的文件会从模板恢复。
  -->
  <ItemGroup>
    <None Update="Bots\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    客户端版本文件（Zircon.dll）：服务端用它算 SHA256 做版本校验（Config.VersionPath 默认 .\Zircon.dll）。
    文件不在服务端目录 → Config.ClientHash = null → IsMatch 必 false → **任何真实客户端都连不上**。
    这里从客户端输出目录按需复制一份过来，避免"忘了放文件"导致开服即不可用。
    客户端没编译过（文件不存在）时跳过，不影响构建；跨机部署仍需手工拷一次。
  -->
  <ItemGroup Condition="Exists('..\..\Debug\Client\Zircon.dll')">
    <None Include="..\..\Debug\Client\Zircon.dll" Link="Zircon.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\Release\Client\Zircon.dll')">
    <None Include="..\..\Release\Client\Zircon.dll" Link="Zircon.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>..\..\Debug\Server.Web\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;CA1416</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>..\..\Release\Server.Web\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;CA1416</NoWarn>
  </PropertyGroup>
</Project>
